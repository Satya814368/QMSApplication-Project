@page
@model QMSApplication.Pages.VerifyPasswordOtpModel
@{ ViewData["Title"] = "Verify password recovery code"; }
<div class="card p-4"><h1 class="h3">Verify email code</h1>
@if (Model.Done) { <p>Password updated successfully.</p><a asp-page="/Login">Sign in</a> }
else {
<p>If an eligible account matches, a six-digit code has been emailed. Check your inbox and spam folder. The code expires after five minutes.</p>
<div asp-validation-summary="All" class="text-danger"></div>
<form method="post">
<label asp-for="Code">Email OTP</label><input asp-for="Code" class="form-control mb-3" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required />
<label asp-for="Password">New password (12–128 characters)</label><input asp-for="Password" type="password" class="form-control mb-3" minlength="12" maxlength="128" autocomplete="new-password" required />
<label asp-for="ConfirmPassword">Confirm new password</label><input asp-for="ConfirmPassword" type="password" class="form-control mb-3" autocomplete="new-password" required />
<button class="btn btn-primary" type="submit">Verify OTP and reset password</button></form>
<a asp-page="/forgotpassword" class="mt-3">Request another code</a>
}</div>
