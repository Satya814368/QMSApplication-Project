@page
@model QMSApplication.Pages.TimesheetsModel
@{ ViewData["Title"] = "Time Sheets"; }
<style>
.ts-wrap{max-width:1280px;margin:auto}.ts-header{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center;margin-bottom:22px}.ts-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px;margin-bottom:22px}.ts-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:20px;box-shadow:0 2px 9px #0f172a08}.ts-number{font-size:28px;font-weight:750;color:#163a65}.ts-muted{color:#64748b;font-size:13px}.ts-form{display:flex;gap:12px;flex-wrap:wrap;align-items:end}.ts-form label{font-size:13px;font-weight:600;display:block;margin-bottom:4px}.ts-form input,.ts-form select{padding:9px;border:1px solid #cbd5e1;border-radius:8px;max-width:100%}.ts-table{width:100%;border-collapse:collapse;font-size:14px}.ts-table th,.ts-table td{padding:11px;border-bottom:1px solid #e2e8f0;text-align:left}.ts-scroll{overflow:auto}.ts-pill{border-radius:20px;background:#eff6ff;color:#1d4ed8;padding:4px 9px;font-size:12px}.ts-btn{background:#1d4ed8;color:white;border:0;border-radius:8px;padding:9px 15px;cursor:pointer}.ts-btn.alt{background:#475569}.ts-btn.warn{background:#b45309}.ts-btn.ok{background:#15803d}.ts-title{font-size:20px;font-weight:700;margin-bottom:14px}

/* Full-width timesheets with compact cards and responsive form controls. */
.ts-wrap{width:100%;max-width:none;margin:0;min-width:0}
.ts-header{gap:8px;margin-bottom:12px}.ts-header h1{margin:0 0 4px}.ts-header p{margin:0}
.ts-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:12px}
.ts-card{padding:14px;min-width:0}.ts-number{font-size:24px}.ts-title{font-size:18px;margin-bottom:10px}
.ts-form{gap:8px;align-items:end}.ts-form>div{flex:1 1 125px;min-width:0}.ts-form input,.ts-form select{width:100%;min-width:0;padding:7px;box-sizing:border-box}
.ts-form>div:has([name=description]){flex-basis:190px}.ts-form>button{flex:0 0 auto}
.ts-table th,.ts-table td{padding:8px}.ts-scroll{max-width:100%}.ts-btn{padding:8px 12px}
.ts-card p.ts-muted{margin-bottom:0}.ts-card td form{margin-bottom:3px}
@@media(max-width:1000px){.ts-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@@media(max-width:520px){.ts-grid{grid-template-columns:1fr}.ts-form>div{flex-basis:100%}.ts-card{padding:12px}}
</style>
<div class="ts-wrap">
<div class="ts-header"><div><h1>Time Sheets</h1><p class="ts-muted">9:00 AM–6:00 PM · Lunch 1:00–2:00 PM · 8 working hours · India Standard Time</p></div><span class="ts-pill">@Model.RoleName view</span></div>
@if (!string.IsNullOrEmpty(Model.Notice)){<div class="alert alert-info">@Model.Notice</div>}
@{var mine = Model.Entries.Where(e => e.UserId == Model.MyId).ToList(); var total = Model.Entries.Where(e => e.EndUtc != null).Sum(e => e.WorkMinutes ?? 0); var meeting = Model.Entries.Where(e => e.Kind != "Task").Sum(e => e.WorkMinutes ?? 0);}
<div class="ts-grid"><div class="ts-card"><div class="ts-muted">Visible employees</div><div class="ts-number">@Model.Employees.Count</div></div><div class="ts-card"><div class="ts-muted">Recorded task hours</div><div class="ts-number">@((total-meeting)/60)h @((total-meeting)%60)m</div></div><div class="ts-card"><div class="ts-muted">Meeting / session hours</div><div class="ts-number">@(meeting/60)h @(meeting%60)m</div></div><div class="ts-card"><div class="ts-muted">Pending approvals</div><div class="ts-number">@Model.Entries.Count(e=>e.Status=="Submitted")</div></div></div>
<div class="ts-card" style="margin-bottom:12px"><div class="ts-title">My task timer</div>
@if (Model.Active != null){<p><strong>Running:</strong> @Model.Active.Target?.TargetNumber — started @QMSApplication.Pages.TimesheetsModel.Local(Model.Active.StartUtc).ToString("dd MMM yyyy hh:mm tt")</p><form method="post" asp-page-handler="Stop"><input type="hidden" name="entryId" value="@Model.Active.Id"/><button class="ts-btn warn">End task timer</button></form>}
else {<form method="post" asp-page-handler="Start" class="ts-form"><div><label>Assigned target</label><select name="targetId" required><option value="">Select task</option>@foreach(var t in Model.Targets){<option value="@t.Id">@t.Task.Language · @t.TargetNumber</option>}</select></div><button class="ts-btn">Start task timer</button></form>}
<p class="ts-muted" style="margin-top:8px">Time is recorded from server timestamps. Only working hours count; the lunch break is automatically excluded.</p></div>
@if(Model.IsManager){<div class="ts-card" style="margin-bottom:12px"><div class="ts-title">Manager · Add meeting or session</div><form method="post" asp-page-handler="Meeting" class="ts-form"><div><label>Employee</label><select name="userId" required>@foreach(var u in Model.Employees){<option value="@u.Id">@u.FullName</option>}</select></div><div><label>Type</label><select name="kind"><option>Meeting</option><option>Training</option><option>Session</option></select></div><div><label>Date</label><input type="date" name="day" value="@DateTime.Today.ToString("yyyy-MM-dd")" required/></div><div><label>Start</label><input type="time" name="start" value="11:00" required/></div><div><label>End</label><input type="time" name="end" value="12:00" required/></div><div><label>Description</label><input name="description" maxlength="120" placeholder="Purpose / agenda"/></div><button class="ts-btn">Add session</button></form><p class="ts-muted" style="margin-top:8px">Only Admin/Manager may add sessions. Entries must not overlap existing time records.</p></div>}
<div class="ts-card"><div class="ts-title">@(Model.CanReview ? "Department / team timesheets" : "My time entries")</div><div class="ts-scroll"><table class="ts-table"><thead><tr><th>Employee</th><th>Type / Task</th><th>Start (IST)</th><th>End (IST)</th><th>Working time</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var e in Model.Entries){<tr><td>@e.User.FullName</td><td>@(e.Kind == "Task" ? (e.Target?.Task?.Language + " / " + e.Target?.TargetNumber) : e.Kind + " · " + e.Description)</td><td>@QMSApplication.Pages.TimesheetsModel.Local(e.StartUtc).ToString("dd MMM HH:mm")</td><td>@(e.EndUtc.HasValue ? QMSApplication.Pages.TimesheetsModel.Local(e.EndUtc.Value).ToString("dd MMM HH:mm") : "Running")</td><td>@(e.WorkMinutes.HasValue ? $"{e.WorkMinutes/60}h {e.WorkMinutes%60}m" : "—")</td><td><span class="ts-pill">@e.Status</span></td><td>@if(e.UserId==Model.MyId && e.Status=="Draft" && e.EndUtc!=null){<form method="post" asp-page-handler="Submit"><input type="hidden" name="entryId" value="@e.Id"/><button class="ts-btn alt">Submit</button></form>}else if(Model.CanReview && e.UserId!=Model.MyId && e.Status=="Submitted"){<form method="post" asp-page-handler="Review" style="display:inline"><input type="hidden" name="entryId" value="@e.Id"/><input type="hidden" name="approve" value="true"/><button class="ts-btn ok">Approve</button></form> <form method="post" asp-page-handler="Review" style="display:inline"><input type="hidden" name="entryId" value="@e.Id"/><input type="hidden" name="approve" value="false"/><button class="ts-btn warn">Reject</button></form>}</td></tr>}</tbody></table></div></div>
</div>
