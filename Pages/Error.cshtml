@page
@model ErrorModel
@{ ViewData["Title"] = "Something went wrong"; }
<div class="qms-form-card">
    <h1>Something went wrong</h1>
    <p>We couldn’t open this page. Please return to your workspace and try again.</p>
    @if (Model.ShowRequestId)
    { <p class="text-muted">If the problem continues, share this reference with your administrator: <code>@Model.RequestId</code></p> }
    <a asp-page="/Dashboard" class="btn btn-primary">Return to dashboard</a>
</div>
