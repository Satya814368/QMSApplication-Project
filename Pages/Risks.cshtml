@page
@model QMSApplication.Pages.RisksModel
@{ ViewData["Title"] = "Risks & Issues"; var r = Model.Edit; var full = Model.CanManage || (r == null && Model.CanReport); }
<h1 class="h3">Risks &amp; Issues</h1>
<p class="text-muted">Register risks, mitigation plans and corrective actions. <a asp-page="/Reports" asp-route-Section="risks">View analytics</a></p>
@if(Model.OverdueCount > 0){<div class="alert alert-warning">@Model.OverdueCount overdue open risk(s) or issue(s) in your authorized scope.</div>}
@if(full || (r != null && r.OwnerId == Model.ActorId && Model.CanReport && r.Status != "Closed")) {
<div class="card p-3 mb-3"><h2 class="h5">@(r == null ? "New record" : "Update record #" + r.Id)</h2>
<form method="post" asp-page-handler="Save" class="row g-2">
<input type="hidden" name="id" value="@(r?.Id ?? 0)"/><input type="hidden" name="version" value="@(r?.Version ?? Guid.Empty)"/>
@if(full) {
<div class="col-md-3"><label>Type<select id="risk-kind" name="kind" class="form-select">@if(Model.CanManage){<option selected="@(r?.Kind == "Risk")">Risk</option>}<option selected="@(r?.Kind == "Issue")">Issue</option></select></label></div>
<div class="col-md-6"><label class="w-100">Title<input name="title" required maxlength="200" class="form-control" value="@(r?.Title)"/></label></div>
<div class="col-md-3"><label class="w-100">Category<select name="category" class="form-select">@foreach(var c in Model.Categories){<option selected="@(r?.Category == c)">@c</option>}</select></label></div>
<div class="col-12"><label class="w-100">Description<textarea name="description" required maxlength="4000" class="form-control">@(r?.Description)</textarea></label></div>
<div class="col-md-3"><label class="w-100">Team *<select id="risk-team" name="teamId" required class="form-select"><option value="">Select team</option>@foreach(var t in Model.Teams){<option value="@t.Id" selected="@(r?.TeamId == t.Id)">@t.Name</option>}</select></label></div>
<div class="col-md-3"><label class="w-100">Owner *<select id="risk-owner" name="ownerId" required class="form-select"><option value="">Select owner</option>@foreach(var o in Model.OwnerChoices){<option data-team="@o.TeamId" value="@o.Id" selected="@(r?.OwnerId == o.Id && r?.TeamId == o.TeamId)">@o.Label</option>}</select></label></div>
<div class="col-md-3"><label class="w-100">Due date<input type="date" name="dueDate" required class="form-control" value="@(r?.DueDate.ToString("yyyy-MM-dd"))"/></label></div>
<div class="col-md-3"><label class="w-100">Deliverable (optional)<input id="risk-deliverable-search" class="form-control mb-1" placeholder="Search deliverables"/><select id="risk-deliverable" name="deliverableId" class="form-select"><option value="">None</option>@foreach(var d in Model.DeliverableChoices){<option data-team="@d.TeamId" value="@d.Id" selected="@(r?.DeliverableId == d.Id)">@d.Label</option>}</select></label></div>
@if(Model.CanManage){<div class="col-md-3"><label>Probability (risk only)<input type="number" id="risk-probability" name="probability" min="1" max="5" value="@((r?.Probability ?? 0) > 0 ? r!.Probability : 1)" class="form-control"/></label></div><div class="col-md-3"><label>Impact (risk only)<input type="number" id="risk-impact" name="impact" min="1" max="5" value="@((r?.Impact ?? 0) > 0 ? r!.Impact : 1)" class="form-control"/></label></div>}
}
<div class="col-md-3"><label class="w-100">Status<select name="status" class="form-select">@foreach(var s in (Model.CanManage ? new[]{"Open","In Progress","Resolved","Closed"} : r == null ? new[]{"Open"} : new[]{"Open","In Progress","Resolved"})){<option selected="@(r?.Status == s)">@s</option>}</select></label></div>
<div class="col-12"><label class="w-100">Mitigation / corrective action<textarea name="actionPlan" maxlength="4000" class="form-control">@(r?.ActionPlan)</textarea></label></div>
<div class="col-12"><strong id="risk-score" aria-live="polite"></strong></div>
<div class="col-12"><button class="btn btn-primary">Save</button> <a asp-page="/Risks" class="btn btn-outline-secondary">New / clear</a></div>
</form></div>}
<div class="card p-3 mb-3"><h2 class="h5">Filter register</h2><div class="nav nav-pills mb-2"><a class="nav-link @(string.IsNullOrEmpty(Model.KindFilter)?"active":"")" asp-page="/Risks">All</a><a class="nav-link @(Model.KindFilter=="Risk"?"active":"")" asp-page="/Risks" asp-route-kind="Risk">Risks</a><a class="nav-link @(Model.KindFilter=="Issue"?"active":"")" asp-page="/Risks" asp-route-kind="Issue">Issues</a></div><form method="get" class="row g-2"><div class="col-md-3"><label>Type<select name="kind" class="form-select"><option value="">All</option>@foreach(var k in new[]{"Risk","Issue"}){<option selected="@(Model.KindFilter==k)">@k</option>}</select></label></div><div class="col-md-3"><label>Search<input name="search" value="@Model.Search" class="form-control"/></label></div><div class="col-md-3"><label>Status<select name="status" class="form-select"><option value="">All</option>@foreach(var st in new[]{"Open","In Progress","Resolved","Closed"}){<option selected="@(Model.StatusFilter==st)">@st</option>}</select></label></div><div class="col-md-3"><label>Sort<select name="sort" class="form-select"><option value="">Newest</option><option value="due" selected="@(Model.Sort=="due")">Due date</option><option value="score" selected="@(Model.Sort=="score")">Risk score</option></select></label></div><div class="col-12"><button class="btn btn-primary">Apply</button> <a asp-page="/Risks" class="btn btn-outline-secondary">Clear</a> <a asp-page-handler="Export" asp-route-kind="@Model.KindFilter" asp-route-search="@Model.Search" asp-route-status="@Model.StatusFilter" asp-route-sort="@Model.Sort" class="btn btn-outline-success">Export Excel</a></div></form></div>
<div class="card p-3"><h2 class="h5">Register (@Model.Rows.Count)</h2><partial name="_RiskRows" model="Model.Rows"/></div>
@if(Model.History.Count > 0){<div class="card p-3 mt-3"><h2 class="h5">Audit history</h2>@foreach(var h in Model.History){<details><summary>@h.AtUtc.ToString("u") — @h.Actor</summary><p>Before: @h.BeforeJson</p><p>After: @h.AfterJson</p></details>}</div>}

<div class="card p-3 mt-3"><h2 class="h5">Risk assessment matrix</h2><div class="table-responsive"><table class="table table-bordered text-center"><thead><tr><th>Probability / Impact</th>@for(int i=1;i<=5;i++){<th>@i</th>}</tr></thead><tbody>@for(int p=5;p>=1;p--){<tr><th>@p</th>@for(int i=1;i<=5;i++){var score=p*i;var color=score>=15?"danger":score>=10?"warning":score>=5?"info":"success";<td><span class="badge bg-@color">@score</span></td>}</tr>}</tbody></table></div><p class="small">Low 1–4 · Medium 5–9 · High 10–14 · Critical 15–25</p></div>
@section Scripts {<script src="~/js/risks-phase2.js" asp-append-version="true"></script>}
