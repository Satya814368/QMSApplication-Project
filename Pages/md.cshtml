@page
@model QMSApplication.Pages.MDModel

<style>



/* Bulk Upload button */
.bulk-upload-button {
    display: inline-block;
    padding: 10px 18px;
    background-color: #198754;
    color: #ffffff !important;
    border: 1px solid #198754;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 600;
    text-align: center;
    text-decoration: none !important;
    cursor: pointer;
    transition: background-color 0.2s ease,
                border-color 0.2s ease;
}

.bulk-upload-button:hover {
    background-color: #146c43;
    border-color: #13653f;
    color: #ffffff !important;
    text-decoration: none !important;
}

.bulk-upload-button:focus-visible {
    outline: 3px solid rgba(25, 135, 84, 0.35);
    outline-offset: 2px;
}



    .md-page {
        min-width: 1024px;
        width: 100%;
        padding: 20px;
        font-family: Arial, sans-serif;
    }

    .md-title {
        background-color: #1f3c88;
        color: white;
        padding: 15px 20px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .md-title h1 {
            margin: 0;
            font-size: 24px;
        }

    .dashboard-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        color: white;
        text-decoration: none;
        border: 1px solid rgba(255, 255, 255, 0.7);
        border-radius: 5px;
        flex-shrink: 0;
        transition: background-color 0.2s, color 0.2s;
    }

        .dashboard-back:hover {
            background-color: white;
            color: #1f3c88;
        }

        .dashboard-back span {
            font-size: 27px;
            line-height: 1;
        }

    .search-filter-box {
        background-color: white;
        border: 1px solid #d5d5d5;
        padding: 18px;
        margin-bottom: 20px;
    }

    .search-filter-title {
        font-size: 18px;
        font-weight: bold;
        color: #1f3c88;
        margin-bottom: 15px;
    }

    .search-row {
        display: flex;
        gap: 10px;
        align-items: center;
        margin-bottom: 15px;
    }

    .search-input {
        width: 450px;
        max-width: 100%;
        padding: 10px 12px;
        border: 1px solid #bdbdbd;
        border-radius: 4px;
        font-size: 14px;
    }

    .filter-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
    }

    .filter-select {
        min-width: 190px;
        padding: 9px 10px;
        border: 1px solid #bdbdbd;
        border-radius: 4px;
        background-color: white;
        font-size: 14px;
    }

    .button {
        padding: 10px 18px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
        font-weight: bold;
        text-decoration: none;
        display: inline-block;
    }

    .apply-button {
        background-color: #1f3c88;
        color: white;
    }

        .apply-button:hover {
            background-color: #162d69;
        }

    .clear-button {
        background-color: #777777;
        color: white;
    }

        .clear-button:hover {
            background-color: #555555;
        }

    .md-table-container {
        width: 100%;
        height: 70vh;
        overflow: auto;
        border: 1px solid #cccccc;
        background-color: white;
        position: relative;
    }

        .md-table-container.maximized {
            position: fixed;
            inset: 0;
            width: 100vw;
            height: 100vh;
            max-height: none;
            z-index: 9999;
            background: white;
            border: none;
            padding: 12px;
            box-sizing: border-box;
        }

            .md-table-container.maximized .md-table {
                min-width: 2300px;
            }

    .md-table-toolbar {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 6px;
    }

    .maximize-button {
        background: #1f3c88;
        color: white;
        border: none;
        border-radius: 4px;
        padding: 8px 12px;
        cursor: pointer;
        font-size: 18px;
    }

        .maximize-button:hover {
            background: #162d69;
        }

    .md-table {
        border-collapse: separate;
        border-spacing: 0;
        width: max-content;
        min-width: 2300px;
    }

        .md-table th,
        .md-table td {
            padding: 10px 12px;
            border-right: 1px solid #dddddd;
            border-bottom: 1px solid #dddddd;
            text-align: left;
            vertical-align: top;
            white-space: nowrap;
        }

        .md-table thead th {
            position: sticky;
            top: 0;
            z-index: 10;
            background-color: #1f3c88;
            color: white;
            font-weight: bold;
        }

        .md-table tbody tr:nth-child(even) {
            background-color: #f8f9fa;
        }

        .md-table tbody tr:hover {
            background-color: #eef3ff;
        }

        .md-table th:nth-child(1),
        .md-table td:nth-child(1) {
            position: sticky;
            left: 0;
            z-index: 6;
            background-color: white;
            min-width: 110px;
        }

        .md-table thead th:nth-child(1) {
            z-index: 20;
            background-color: #1f3c88;
        }

        .md-table tbody tr:nth-child(even) td:nth-child(1) {
            background-color: #f8f9fa;
        }

    .record-id {
        font-weight: bold;
    }

    .action-link {
        display: inline-block;
        margin-right: 10px;
        color: #1f3c88;
        font-weight: bold;
        text-decoration: none;
    }

        .action-link:hover {
            text-decoration: underline;
        }

    .delete-button {
        display: inline-block;
        background-color: #dc3545;
        color: white;
        border: none;
        border-radius: 4px;
        padding: 6px 10px;
        font-size: 13px;
        font-weight: bold;
        cursor: pointer;
    }

        .delete-button:hover {
            background-color: #b02a37;
        }

    .overdue-indicator {
        color: red;
        font-weight: bold;
    }

    .no-records {
        padding: 20px;
        color: #666666;
    }
</style>

<div class="md-page">

    <div class="md-title">
        <a asp-page="/Dashboard"
           class="dashboard-back"
           title="Go to Dashboard"
           aria-label="Go to Dashboard">
            <span>&#8592;</span>
        </a>

        <h1>Milestones &amp; Deliverables</h1>
    </div>

    <!-- SEARCH AND FILTERS -->
    <form method="get">
        <div class="search-filter-box">

            <div class="search-filter-title">
                Search and Filters
            </div>

            <div class="search-row">
                <input type="text"
                       name="Search"
                       value="@Model.Search"
                       class="search-input"
                       placeholder="Search Milestone Name, Deliverable Name, Assigned To, or Status" />

                <button type="submit"
                        class="button apply-button">
                    Search / Apply
                </button>

                <a asp-page="/MD"
                   class="button clear-button">
                    Clear
                </a>
            </div>

            <div class="filter-row">

                <select name="MilestoneFilter"
                        class="filter-select">
                    <option value="">All Milestone Names</option>

                    @foreach (var item in Model.MilestoneNames)
                    {
                        if (string.Equals(item, Model.MilestoneFilter,
                            StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@item" selected>@item</option>
                        }
                        else
                        {
                            <option value="@item">@item</option>
                        }
                    }
                </select>

                <select name="AssignedToFilter"
                        class="filter-select">
                    <option value="">All Assigned To</option>

                    @foreach (var item in Model.AssignedToNames)
                    {
                        if (string.Equals(item, Model.AssignedToFilter,
                            StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@item" selected>@item</option>
                        }
                        else
                        {
                            <option value="@item">@item</option>
                        }
                    }
                </select>

                <select name="StatusFilter"
                        class="filter-select">
                    <option value="">All Statuses</option>

                    @foreach (var item in Model.Statuses)
                    {
                        if (string.Equals(item, Model.StatusFilter,
                            StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@item" selected>@item</option>
                        }
                        else
                        {
                            <option value="@item">@item</option>
                        }
                    }
                </select>

                <select name="DeliverableTypeFilter"
                        class="filter-select">
                    <option value="">All Deliverable Types</option>

                    @foreach (var item in Model.DeliverableTypes)
                    {
                        if (string.Equals(item, Model.DeliverableTypeFilter,
                            StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@item" selected>@item</option>
                        }
                        else
                        {
                            <option value="@item">@item</option>
                        }
                    }
                </select>

                <select name="ScheduleDeviationFilter"
                        class="filter-select">
                    <option value="">All Schedule Deviations</option>

                    @foreach (var item in Model.ScheduleDeviations)
                    {
                        if (string.Equals(item, Model.ScheduleDeviationFilter,
                            StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@item" selected>@item</option>
                        }
                        else
                        {
                            <option value="@item">@item</option>
                        }
                    }
                </select>

                <!-- DEPARTMENT NAME FILTER -->
                <select name="DepartmentFilter"
                        class="filter-select">
                    <option value="">All Departments</option>

                    @foreach (var item in Model.Departments)
                    {
                        if (string.Equals(item, Model.DepartmentFilter,
                            StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@item" selected>@item</option>
                        }
                        else
                        {
                            <option value="@item">@item</option>
                        }
                    }
                </select>

            </div>
        </div>
    </form>

    <div style="margin: 15px 0; display: flex; gap: 12px; align-items: center;">
    <a asp-page="/MDCreate"
       class="button apply-button">
        + Add New Deliverable
    </a>

    <a asp-page="/MDImport"
       class="bulk-upload-button">
        Bulk Upload
    </a>
</div>

            <script>
                        (() => {
                            const container = document.getElementById("mdTableContainer");
                            const button = document.getElementById("maximizeMDTable");

                            if (!container || !button) return;

                            function toggleMaximize() {
                                const maximized = container.classList.toggle("maximized");

                                button.setAttribute("aria-pressed", String(maximized));
                                button.setAttribute(
                                    "aria-label",
                                    maximized
                                        ? "Restore M and D table"
                                        : "Maximize M and D table"
                                );

                                button.title = maximized ? "Restore table" : "Maximize table";
                                button.textContent = maximized ? "⛶ Restore" : "⛶";
                            }

                            button.addEventListener("click", toggleMaximize);

                            document.addEventListener("keydown", event => {
                                if (event.key === "Escape" &&
                                    container.classList.contains("maximized")) {
                                    toggleMaximize();
                                }
                            });
                        })();
            </script>

            <table class="md-table">
                <thead>
                    <tr>
                        <th>Record ID</th>
                        <th>Department Name</th>
                        <th>Milestone Name</th>
                        <th>Deliverable Name</th>
                        <th>Deliverable Type</th>
                        <th>Milestone Target Date</th>
                        <th>Deliverable Target Date</th>
                        <th>Assigned To</th>
                        <th>Any Schedule Deviation</th>
                        <th>Deliverable at Which Activity</th>
                        <th>Reason for Schedule Deviation</th>
                        <th>Deliverable Actual Completed Date</th>
                        <th>Milestone Achieved Date</th>
                        <th>Status</th>
                        <th>Remarks</th>
                        <th>UGs</th>
                        <th>Actions</th>
                        <th>Due Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var record in Model.Records)
                    {
                        <tr>
                            <td class="record-id">@record.RecordID</td>
                            <td>@record.DepartmentName</td>
                            <td>@record.MilestoneName</td>
                            <td>@record.DeliverableName</td>
                            <td>@record.DeliverableType</td>
                            <td>@record.MilestoneTargetDate</td>
                            <td>@record.DeliverableTargetDate</td>
                            <td>@record.AssignedTo</td>
                            <td>@record.ScheduleDeviation</td>
                            <td>@record.DeliverableActivity</td>
                            <td>@record.DeviationReason</td>
                            <td>@record.DeliverableActualCompletedDate</td>
                            <td>@record.MilestoneAchievedDate</td>
                            <td>@record.Status</td>
                            <td>@record.Remarks</td>
                            <td>@record.UGs</td>

                            <!-- VIEW, EDIT AND DELETE -->
                            <td>
                                <a class="action-link"
                                   asp-page="/MDView"
                                   asp-route-id="@record.RecordID">
                                    View
                                </a>

                                <a class="action-link"
                                   asp-page="/MDEdit"
                                   asp-route-id="@record.RecordID">
                                    Edit
                                </a>

                                <form method="post"
                                      asp-page-handler="Delete"
                                      asp-route-id="@record.RecordID"
                                      style="display:inline"
                                      onsubmit="return confirm('Are you sure you want to delete record @record.RecordID?');">
                                    <button type="submit"
                                            class="delete-button">
                                        Delete
                                    </button>
                                </form>
                            </td>

                            <td>
                                @if (record.IsOverdue)
                                {
                                    <span class="overdue-indicator">
                                        Overdue
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="no-records">
            No M &amp; D records found for the selected search/filter criteria.
        </div>
    }
</div>
