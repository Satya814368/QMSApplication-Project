@page
@model QMSApplication.Pages.MyTeamModel
@using QMSApplication.Data
@{
    ViewData["Title"] = "My Team";
    var leadOptions = Model.Users.Where(u => TeamSetupService.Role(u.Role) == "Team Lead").ToList();
    var managerOptions = Model.Users.Where(u => TeamSetupService.Role(u.Role) == "Manager").ToList();
    var memberOptions = Model.Users.Where(u => TeamSetupService.Role(u.Role) == "User").ToList();
    var managersByTeam = Model.Managers.ToLookup(m => m.TeamId);
    var activeMembers = Model.TeamMembers.Values.Sum(members => members.Count);
    var leadsAssigned = Model.Teams.Count(t => t.LeadUserId.HasValue);
}
<div class="mt-workspace">
    <header class="mt-hero">
        <div>
            <p class="mt-eyebrow">People &amp; teams</p>
            <h1>My Team</h1>
            <p>See who leads each team, browse the roster, and manage memberships from one place.</p>
        </div>
        <nav class="mt-jumps" aria-label="On this page">
            @if (Model.Teams.Count > 0)
            {
                <a class="btn mt-hero-link" href="#team-members">Manage members</a>
            }
            @if (Model.CanSetLeadership)
            {
                <a class="btn mt-hero-primary" href="#create-team">+ Create team</a>
            }
        </nav>
    </header>

    @if (TempData["TeamSuccess"] is string message)
    {
        <div class="alert alert-success" role="status">@message</div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    }

    <dl class="mt-metrics" aria-label="Team overview">
        <div><dt>Teams in your view</dt><dd>@Model.Teams.Count</dd></div>
        <div><dt>Active roster members</dt><dd>@activeMembers</dd></div>
        <div><dt>Teams with a lead assigned</dt><dd>@leadsAssigned <small>of @Model.Teams.Count</small></dd></div>
    </dl>

    <section aria-labelledby="team-directory-heading">
        <div class="mt-section-title">
            <h2 id="team-directory-heading">Team directory</h2>
            <p>View the leadership and roster for each team you manage or lead.</p>
        </div>
        @if (Model.Teams.Count == 0)
        {
            <div class="mt-empty mt-panel">
                <h3>No teams to show yet</h3>
                <p>@(Model.CanSetLeadership ? "Create a team below to get started." : "Ask an Admin or Manager to check your team assignment.")</p>
            </div>
        }
        <div class="mt-team-grid">
        @foreach (var team in Model.Teams)
        {
            var managers = managersByTeam[team.Id].ToList();
            var availableManagers = managerOptions.Where(u => !managers.Any(m => m.UserId == u.Id)).ToList();
            var roster = Model.TeamMembers[team.Id];
            <article class="mt-panel mt-team">
                <header class="mt-card-heading">
                    <span class="mt-monogram" aria-hidden="true">@(char.ToUpperInvariant(team.Name.FirstOrDefault()))</span>
                    <div>
                        <h3>@team.Name</h3>
                        <span class="mt-chip">@(team.Department?.Name ?? "No department")</span>
                    </div>
                </header>
                <dl class="mt-leadership">
                    <div><dt>Team Lead</dt><dd>@(team.LeadUserId.HasValue ? Model.UserName(team.LeadUserId.Value) : "Not assigned")</dd></div>
                    <div><dt>Managers</dt><dd>@(managers.Count == 0 ? "Not assigned" : string.Join(", ", managers.Select(m => Model.UserName(m.UserId))))</dd></div>
                </dl>
                <details class="mt-disclosure">
                    <summary><span>Active roster</span><span class="mt-chip">@roster.Count</span></summary>
                    @if (roster.Count == 0)
                    {
                        <p class="mt-muted">No active members in this team.</p>
                    }
                    else
                    {
                        <ul class="mt-roster">
                        @foreach (var member in roster)
                        {
                            <li>
                                <span class="mt-avatar" aria-hidden="true">@(char.ToUpperInvariant(member.FullName.FirstOrDefault()))</span>
                                <span><strong>@member.FullName</strong><small>@member.Username</small></span>
                            </li>
                        }
                        </ul>
                    }
                </details>
                @if (Model.CanSetLeadership)
                {
                    <details class="mt-disclosure">
                        <summary>Team settings</summary>
                        <div class="mt-settings">
                            <form method="post" asp-page-handler="Lead" class="mt-action">
                                <input type="hidden" name="teamId" value="@team.Id" />
                                <input type="hidden" name="version" value="@team.Version" />
                                <div><label for="lead-@team.Id">Team Lead</label>
                                    <select name="leadId" id="lead-@team.Id" class="form-select">
                                        <option value="">No lead</option>
                                        @foreach (var user in leadOptions)
                                        {
                                            <option value="@user.Id" selected="@(team.LeadUserId == user.Id)">@user.FullName (@user.Username)</option>
                                        }
                                    </select>
                                </div>
                                <button class="btn btn-outline-primary" type="submit">Save lead</button>
                            </form>
                            @if (Model.IsAdmin)
                            {
                                <form method="post" asp-page-handler="Department" class="mt-action">
                                    <input type="hidden" name="teamId" value="@team.Id" />
                                    <input type="hidden" name="version" value="@team.Version" />
                                    <div><label for="dept-@team.Id">Department</label>
                                        <select name="departmentId" id="dept-@team.Id" class="form-select">
                                            <option value="">No department</option>
                                            @foreach (var department in Model.Departments)
                                            {
                                                <option value="@department.Id" selected="@(team.DepartmentId == department.Id)">@department.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <button class="btn btn-outline-primary" type="submit">Save department</button>
                                </form>
                                @if (availableManagers.Count > 0)
                                {
                                    <form method="post" asp-page-handler="Manager" class="mt-action">
                                        <input type="hidden" name="teamId" value="@team.Id" />
                                        <input type="hidden" name="version" value="@team.Version" />
                                        <div><label for="manager-@team.Id">Add Manager</label>
                                            <select name="managerId" id="manager-@team.Id" class="form-select" required>
                                                <option value="">Select Manager</option>
                                                @foreach (var user in availableManagers)
                                                {
                                                    <option value="@user.Id">@user.FullName (@user.Username)</option>
                                                }
                                            </select>
                                        </div>
                                        <button class="btn btn-outline-primary" type="submit">Assign Manager</button>
                                    </form>
                                }
                                else
                                {
                                    <p class="mt-muted">No additional active Managers to assign.</p>
                                }
                                @foreach (var manager in managers)
                                {
                                    <form method="post" asp-page-handler="Manager" class="mt-remove-manager">
                                        <input type="hidden" name="teamId" value="@team.Id" />
                                        <input type="hidden" name="managerId" value="@manager.UserId" />
                                        <input type="hidden" name="remove" value="true" />
                                        <input type="hidden" name="version" value="@team.Version" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">Remove Manager: @Model.UserName(manager.UserId)</button>
                                    </form>
                                }
                            }
                        </div>
                    </details>
                }
            </article>
        }
        </div>
    </section>

    @if (Model.CanSetLeadership)
    {
        <section id="create-team" class="mt-panel mt-padded" aria-labelledby="create-team-heading">
            <div class="mt-section-title">
                <h2 id="create-team-heading">Create team</h2>
                <p>After creating a team, open its settings in the directory to assign leadership.</p>
            </div>
            <form method="post" asp-page-handler="Create" class="mt-create">
                <div><label for="team-name">Team name</label><input id="team-name" name="teamName" class="form-control" required maxlength="120" placeholder="e.g. Documentation Team A" /></div>
                @if (Model.IsAdmin)
                {
                    <div><label for="new-team-department">Department</label>
                        <select id="new-team-department" name="departmentId" class="form-select">
                            <option value="">No department</option>
                            @foreach (var department in Model.Departments)
                            {
                                <option value="@department.Id">@department.Name</option>
                            }
                        </select>
                    </div>
                }
                <button class="btn btn-primary" type="submit">Create team</button>
            </form>
        </section>
    }

    @if (Model.Teams.Count > 0)
    {
        <section class="mt-panel mt-members" id="team-members" aria-labelledby="team-members-heading">
            <div class="mt-section-title mt-padded">
                <h2 id="team-members-heading">Manage members</h2>
                <p>Assign, transfer, or unassign active User accounts. Transfers keep existing tasks and deliverable ownership in place.</p>
            </div>
            @if (memberOptions.Count == 0)
            {
                <p class="mt-muted mt-padded">No active User accounts are available.</p>
            }
            else
            {
                <div class="mt-filters" data-mt-filters hidden>
                    <div><label for="member-search">Search members</label><input type="search" id="member-search" class="form-control" placeholder="Name, username, or team" /></div>
                    <div><label for="member-status">Membership</label>
                        <select id="member-status" class="form-select">
                            <option value="">All members</option><option value="assigned">Assigned</option><option value="unassigned">Unassigned</option>
                        </select>
                    </div>
                    <button class="btn btn-outline-secondary" type="button" data-mt-reset>Clear</button>
                    <p class="mt-result-count" data-mt-count role="status"></p>
                </div>
                <p class="mt-empty mt-muted" data-mt-empty hidden>No members match these filters.</p>
                <div class="mt-member-list">
                @foreach (var user in memberOptions)
                {
                    long? source = Model.Memberships.TryGetValue(user.Id, out var sourceId) ? sourceId : null;
                    var currentTeam = source.HasValue ? Model.TeamNames.GetValueOrDefault(source.Value, "Unavailable") : "Unassigned";
                    var targets = Model.Teams.Where(t => t.Id != source).ToList();
                    var canRemove = source.HasValue && Model.Owns(source.Value);
                    <details class="mt-member" data-mt-member data-membership="@(source.HasValue ? "assigned" : "unassigned")">
                        <summary>
                            <span class="mt-member-identity">
                                <span class="mt-avatar" aria-hidden="true">@(char.ToUpperInvariant(user.FullName.FirstOrDefault()))</span>
                                <span data-mt-search><strong>@user.FullName</strong> <small>@user.Username</small></span>
                            </span>
                            <span class="mt-chip" data-mt-search>@currentTeam</span>
                            <span class="mt-member-label">Manage</span>
                        </summary>
                        <div class="mt-member-actions">
                            @if (targets.Count > 0)
                            {
                                <form method="post" asp-page-handler="Member" class="mt-move">
                                    <input type="hidden" name="memberId" value="@user.Id" />
                                    <input type="hidden" name="expectedSourceId" value="@source" />
                                    <div><label for="destination-@user.Id">Destination team</label>
                                        <select name="destinationId" id="destination-@user.Id" class="form-select" required>
                                            <option value="">Select team</option>
                                            @foreach (var team in targets)
                                            {
                                                <option value="@team.Id">@team.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div><label for="move-reason-@user.Id">@(source.HasValue ? "Transfer reason" : "Reason (optional)")</label><input id="move-reason-@user.Id" name="reason" class="form-control" maxlength="500" required="@source.HasValue" /></div>
                                    <button class="btn btn-outline-primary" type="submit">@(source.HasValue ? "Transfer member" : "Assign member")</button>
                                </form>
                            }
                            @if (canRemove)
                            {
                                <form method="post" asp-page-handler="Remove" class="mt-action mt-unassign">
                                    <input type="hidden" name="memberId" value="@user.Id" />
                                    <input type="hidden" name="expectedTeamId" value="@source" />
                                    <div><label for="remove-reason-@user.Id">Reason for unassigning</label><input id="remove-reason-@user.Id" name="reason" class="form-control" required maxlength="500" /></div>
                                    <button class="btn btn-outline-danger" type="submit">Unassign member</button>
                                </form>
                            }
                            @if (targets.Count == 0 && !canRemove)
                            {
                                <p class="mt-muted">No membership changes are available for this account.</p>
                            }
                        </div>
                    </details>
                }
                </div>
            }
        </section>
    }

    @if (Model.IsAdmin)
    {
        <details class="mt-panel mt-disclosure mt-history">
            <summary><span>Team activity</span><span class="mt-chip">Latest @Model.Audits.Count · UTC</span></summary>
            @if (Model.Audits.Count == 0)
            {
                <p class="mt-muted">No team changes recorded yet.</p>
            }
            else
            {
                <ul class="mt-timeline">
                @foreach (var audit in Model.Audits)
                {
                    <li>
                        <details>
                            <summary><strong>@audit.Action</strong><span>@audit.Username · @audit.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</span></summary>
                            <pre>@audit.DetailsJson</pre>
                        </details>
                    </li>
                }
                </ul>
            }
        </details>
    }
</div>
@section Scripts {
    <script src="~/js/my-team.js" asp-append-version="true" defer></script>
}
