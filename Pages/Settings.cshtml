@page
@model QMSApplication.Pages.SettingsModel
@{ ViewData["Title"] = "Settings"; }
<style>
.pmt-settings{max-width:1180px;margin:auto;color:#172c4d}.pmt-settings h1{font-size:1.8rem;font-weight:750}.pmt-settings .muted{color:#64748b}.pmt-settings .layout{display:grid;grid-template-columns:235px minmax(0,1fr);gap:20px;margin-top:22px}.pmt-settings .panel{background:white;border:1px solid #e2e8f0;border-radius:14px;padding:24px;box-shadow:0 2px 12px #132a4510}.pmt-settings .nav a{display:block;padding:12px;border-radius:9px;text-decoration:none;color:#344563;font-weight:600}.pmt-settings .nav a.active{background:#eaf2ff;color:#164a9e}.pmt-settings label{display:block;font-weight:600;margin:14px 0 5px}.pmt-settings input:not([type=checkbox]),.pmt-settings select,.pmt-settings textarea{width:100%;max-width:580px;padding:10px;border:1px solid #cbd5e1;border-radius:8px;background:#fff}.pmt-settings .btn-save{margin-top:20px;background:#164a9e;color:white;border:0;border-radius:8px;padding:10px 20px}.pmt-settings .notice{padding:12px;background:#edf8ef;border:1px solid #badfc1;border-radius:8px;margin-top:15px}.pmt-settings .readonly{background:#f5f7fb;border-radius:8px;padding:12px;margin:8px 0}.pmt-settings .check{display:flex;align-items:center;gap:10px;margin:12px 0}.pmt-settings .check label{margin:0}.pmt-settings table{width:100%;font-size:.9rem}.pmt-settings td,.pmt-settings th{padding:9px;border-bottom:1px solid #e2e8f0;text-align:left;word-break:break-word}@@media(max-width:780px){.pmt-settings .layout{grid-template-columns:1fr}.pmt-settings .nav{display:grid;grid-template-columns:repeat(2,1fr)}}
</style>
<div class="pmt-settings">
<h1>Settings</h1><div class="muted">Manage your account and workspace preferences.</div>
@if (!string.IsNullOrEmpty(Model.Message)) { <div class="notice" role="status">@Model.Message</div> }
<div class="layout">
<aside class="panel nav" aria-label="Settings sections">
@foreach(var entry in new[]{("profile","My Profile"),("security","Security"),("notifications","Notifications"),("appearance","Appearance"),("schedule","Work Schedule"),("timesheets","Timesheet Rules"),("project","Project Settings"),("access","Roles & Access"),("audit","Audit & System")}) {
<a asp-page="/Settings" asp-route-section="@entry.Item1" class="@(Model.Section == entry.Item1 ? "active" : "")">@entry.Item2</a>
}
</aside>
<section class="panel">
@if(Model.Section == "profile") {
<h2>My Profile</h2><p class="muted">Edit your own display name and mobile number. Role and department are managed by Admin.</p>
<form method="post" asp-page-handler="Profile">
<label for="fullName">Full name</label><input id="fullName" name="fullName" maxlength="200" required value="@Model.CurrentUser.FullName" />
<label for="mobileNumber">Mobile number</label><input id="mobileNumber" name="mobileNumber" maxlength="20" value="@Model.CurrentUser.MobileNumber" />
<label>Username</label><div class="readonly">@Model.CurrentUser.Username</div>
<label>Email</label><div class="readonly">@Model.CurrentUser.Email</div>
<label>Role</label><div class="readonly">@Model.CurrentUser.Role</div>
<button class="btn-save" type="submit">Save Profile</button></form>
} else if(Model.Section == "security") {
<h2>Security</h2><p>Use the existing verified password recovery process to reset your password.</p>
<a asp-page="/forgotpassword">Reset password with email verification</a>
<p class="muted" style="margin-top:20px">Email changes, active-session management and two-factor login are not implemented in this release. SMTP secrets are never exposed here.</p>
} else if(Model.Section == "notifications" || Model.Section == "appearance") {
<h2>@(Model.Section == "notifications" ? "Notification Preferences" : "Appearance & Preferences")</h2>
<p class="muted">Your choices are stored per user. Applying themes and notification delivery filters throughout the application is a separate integration step.</p>
<form method="post" asp-page-handler="Preferences">
<label for="theme">Theme</label><select id="theme" name="theme"><option selected="@(Model.Preferences.Theme == "Light")">Light</option><option selected="@(Model.Preferences.Theme == "Dark")">Dark</option><option selected="@(Model.Preferences.Theme == "System")">System</option></select>
<label for="language">Language</label><select id="language" name="language"><option>English</option></select>
<label for="dateFormat">Date format</label><select id="dateFormat" name="dateFormat"><option selected="@(Model.Preferences.DateFormat == "dd-MM-yyyy")">dd-MM-yyyy</option><option selected="@(Model.Preferences.DateFormat == "MM/dd/yyyy")">MM/dd/yyyy</option><option selected="@(Model.Preferences.DateFormat == "yyyy-MM-dd")">yyyy-MM-dd</option></select>
<div class="check"><input type="checkbox" id="taskAlerts" name="taskAlerts" value="true" checked="@Model.Preferences.TaskAlerts" /><label for="taskAlerts">Task alerts</label></div>
<div class="check"><input type="checkbox" id="approvalAlerts" name="approvalAlerts" value="true" checked="@Model.Preferences.ApprovalAlerts" /><label for="approvalAlerts">Approval alerts</label></div>
<div class="check"><input type="checkbox" id="emailAlerts" name="emailAlerts" value="true" checked="@Model.Preferences.EmailAlerts" /><label for="emailAlerts">Email alerts</label></div>
<button class="btn-save" type="submit">Save Preferences</button></form>
} else if(Model.Section == "schedule") {
<h2>Work Schedule</h2><p class="muted">Organization-wide schedule (Admin only). Current Timesheets timer logic is still fixed at 9–6 with lunch 1–2.</p>
@if(Model.IsAdmin) {<form method="post" asp-page-handler="Schedule">
<label>Office start</label><input type="time" name="officeStart" value="@Model.Setting("Schedule.OfficeStart","09:00")" required />
<label>Office end</label><input type="time" name="officeEnd" value="@Model.Setting("Schedule.OfficeEnd","18:00")" required />
<label>Lunch start</label><input type="time" name="lunchStart" value="@Model.Setting("Schedule.LunchStart","13:00")" required />
<label>Lunch end</label><input type="time" name="lunchEnd" value="@Model.Setting("Schedule.LunchEnd","14:00")" required />
<label>Timezone</label><select name="timezone"><option value="Asia/Kolkata">Asia/Kolkata (IST)</option></select>
<button class="btn-save" type="submit">Save Schedule</button></form>}
else {<div class="readonly">@Model.Setting("Schedule.OfficeStart","09:00") – @Model.Setting("Schedule.OfficeEnd","18:00"), lunch @Model.Setting("Schedule.LunchStart","13:00") – @Model.Setting("Schedule.LunchEnd","14:00") (IST)</div>}
} else if(Model.Section == "timesheets") {
<h2>Timesheet Rules</h2><p class="muted">Configuration values for future policy integration; current Timesheets enforcement remains unchanged.</p>
@if(Model.IsAdmin) {<form method="post" asp-page-handler="TimesheetRules">
<div class="check"><input type="checkbox" name="requireApproval" value="true" checked="@(Model.Setting("Timesheets.RequireApproval","True") == "True")" /><label>Require approval</label></div>
<div class="check"><input type="checkbox" name="preventOverlaps" value="true" checked="@(Model.Setting("Timesheets.PreventOverlaps","True") == "True")" /><label>Prevent overlapping entries</label></div>
<label>Monthly submission day</label><input type="number" min="1" max="31" name="submissionDay" value="@Model.Setting("Timesheets.SubmissionDay","25")" />
<button class="btn-save" type="submit">Save Timesheet Rules</button></form>}
else {<div class="readonly">Approval: @Model.Setting("Timesheets.RequireApproval","True") · Prevent overlaps: @Model.Setting("Timesheets.PreventOverlaps","True") · Submission day: @Model.Setting("Timesheets.SubmissionDay","25")</div>}
} else if(Model.Section == "project") {
<h2>Project Settings</h2><p class="muted">Workspace metadata; does not rename existing project files or change workflow logic.</p>
@if(Model.IsAdmin) {<form method="post" asp-page-handler="Project"><label>Workspace name</label><input name="projectName" maxlength="100" required value="@Model.Setting("Project.Name","Project Management Tool")" />
<label>Description</label><textarea name="description" maxlength="500" rows="4">@Model.Setting("Project.Description","")</textarea><button class="btn-save" type="submit">Save Project Settings</button></form>}
else {<div class="readonly">@Model.Setting("Project.Name","Project Management Tool")</div>}
} else if(Model.Section == "access") {
<h2>Roles & Access</h2><p>Role assignments and department access are managed through the existing Manage Users module.</p>
@if(Model.IsAdmin){<a asp-page="/ManageUsers">Open Manage Users</a>} else {<p class="muted">Only Admin can manage roles and privileges.</p>}
} else if(Model.Section == "audit") {
<h2>Audit & System</h2>
@if(Model.IsAdmin) {<p class="muted">Latest 75 settings changes, shown with UTC timestamps.</p><div style="overflow-x:auto"><table><thead><tr><th>UTC</th><th>Actor ID</th><th>Setting</th><th>Previous</th><th>New</th></tr></thead><tbody>
@foreach(var e in Model.AuditEvents){<tr><td>@e.AtUtc.ToString("yyyy-MM-dd HH:mm")</td><td>@e.ActorId</td><td>@e.SettingKey</td><td>@e.PreviousValue</td><td>@e.NewValue</td></tr>}
</tbody></table></div>} else {<p>Audit records are restricted to Admin.</p>}
}
</section></div></div>
