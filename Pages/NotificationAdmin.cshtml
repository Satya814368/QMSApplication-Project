@page
@model QMSApplication.Pages.NotificationAdminModel
@{ViewData["Title"]="Notification management";Layout="_PortalLayout";}
<div class="card p-4">
    <h1 class="h3">Manage Notifications</h1>
    <p class="text-muted">Every published notification requires acknowledgement. Click Track acknowledgements to view member responses.</p>
    @if(Model.CanManage){<div class="mb-4"><a asp-page="/NotificationCreate" class="btn btn-primary">Create notification</a></div>}
    @if(Model.Notifications.Count==0){<p>No notifications are available within your scope.</p>}
    else
    {
        <div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Title</th><th>Published</th><th>Audience</th><th>Date (UTC)</th><th>Actions</th></tr></thead><tbody>
        @foreach(var notice in Model.Notifications)
        {
            <tr><td>@notice.Title</td><td>@(notice.IsPublished?"Yes":"No")</td><td>@(string.IsNullOrWhiteSpace(notice.TargetRole)?"All users":notice.TargetRole)</td><td>@notice.NotificationDateUtc.ToString("dd MMM yyyy HH:mm")</td><td>
                <div class="d-flex flex-wrap gap-2">
                    @if(notice.IsPublished){<button type="button" class="btn btn-sm btn-outline-primary" data-acknowledgements-url="@Url.Page("/NotificationAdmin", "Acknowledgements", new { id = notice.Id })">Track acknowledgements</button>}
                    @if(Model.CanManage)
                    {
                        <a asp-page="/NotificationEdit" asp-route-id="@notice.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <form method="post" asp-page-handler="TogglePublish"><input type="hidden" name="id" value="@notice.Id"/><button class="btn btn-sm btn-outline-secondary">@(notice.IsPublished?"Unpublish":"Publish")</button></form>
                        <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Delete this notification?');"><input type="hidden" name="id" value="@notice.Id"/><button class="btn btn-sm btn-outline-danger">Delete</button></form>
                    }
                </div>
            </td></tr>
        }
        </tbody></table></div>
    }
</div>
<dialog id="acknowledgements-dialog" class="qms-ack-dialog" aria-labelledby="acknowledgements-heading">
    <div class="d-flex justify-content-between align-items-center gap-3 border-bottom p-3"><h2 id="acknowledgements-heading" class="h4 mb-0">Notification acknowledgements</h2><button type="button" class="btn btn-outline-secondary" data-close-acknowledgements aria-label="Close acknowledgements popup">Close</button></div>
    <div id="acknowledgements-body" class="p-3" aria-live="polite"></div>
</dialog>
<noscript><p class="alert alert-info mt-3">Enable JavaScript to open the acknowledgement popup.</p></noscript>
<style>
.qms-ack-dialog{width:min(1120px,94vw);max-width:94vw;max-height:88vh;padding:0;border:1px solid #d8e0eb;border-radius:12px;color:#102c54;box-shadow:0 20px 60px #0005;overflow:auto}
.qms-ack-dialog::backdrop{background:rgba(10,25,45,.55)}
</style>
@section Scripts {<script src="~/js/notification-acknowledgements.js" asp-append-version="true"></script>}
