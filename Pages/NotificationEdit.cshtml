@page
@model QMSApplication.Pages.NotificationEditModel
@{ ViewData["Title"] = "Edit Notification"; }
<div class="qms-form-card">
    <h1>Edit Notification</h1>
    <p class="text-muted">Update the message and its audience.</p>
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <form method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3"><label asp-for="Title" class="form-label">Title <span class="text-danger">*</span></label><input asp-for="Title" class="form-control" required maxlength="200" /></div>
        <div class="mb-3"><label asp-for="Message" class="form-label">Message <span class="text-danger">*</span></label><textarea asp-for="Message" class="form-control" rows="5" required></textarea></div>
        <div class="qms-form-grid">
            <div class="mb-3"><label asp-for="Priority" class="form-label">Priority</label><select asp-for="Priority" class="form-select"><option>Normal</option><option>High</option><option>Critical</option></select></div>
            <div class="mb-3"><label asp-for="TargetRole" class="form-label">Target role</label><select asp-for="TargetRole" class="form-select"><option value="">All Users</option><option>Admin</option><option>Manager</option><option>User</option></select></div>
        </div>
        <div class="form-check mb-3"><input asp-for="IsMandatory" class="form-check-input" /><label asp-for="IsMandatory" class="form-check-label">Mandatory acknowledgement</label></div>
        <div class="form-check mb-3"><input asp-for="IsPublished" class="form-check-input" /><label asp-for="IsPublished" class="form-check-label">Published</label></div>
        <div class="qms-form-actions"><button type="submit" class="btn btn-primary">Save changes</button><a asp-page="/NotificationAdmin" class="btn btn-secondary">Cancel</a></div>
    </form>
</div>
