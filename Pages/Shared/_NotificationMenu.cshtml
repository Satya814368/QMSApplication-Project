@using Microsoft.EntityFrameworkCore
@using QMSApplication.Models
@inject QMSPortalDbContext Db
@{
    var username = Context.Session.GetString("Username");
    var role = Context.Session.GetString("UserRole");
    var pending = string.IsNullOrWhiteSpace(username) ? 0 :
        await QMSApplication.Security.NotificationReaderService.AwaitingAcknowledgement(Db, username, role).CountAsync();
}
<button type="button" class="qms-icon-button" data-open-notification-reader aria-label="Notifications, @pending awaiting acknowledgement" title="Notifications">
    <partial name="_NavIcon" model='@("bell")' />
    <span class="qms-notification-badge" data-pending-notification-count hidden="@(pending==0)">@(pending>99?"99+":pending.ToString())</span>
</button>
