@{
    var pages = new[]
    {
        (Title: "Dashboard", Url: "/Dashboard", Module: ""),
        (Title: "M & D", Url: "/MD", Module: ""),
        (Title: "Reports", Url: "/ComingSoon?module=Reports", Module: "Reports"),
        (Title: "My Tasks", Url: "/ComingSoon?module=MyTasks", Module: "MyTasks"),
        (Title: "My Team", Url: "/ComingSoon?module=MyTeam", Module: "MyTeam"),
        (Title: "Changes", Url: "/ComingSoon?module=Changes", Module: "Changes"),
        (Title: "Time Sheets", Url: "/ComingSoon?module=TimeSheets", Module: "TimeSheets"),
        (Title: "Guidelines", Url: "/Guidelines", Module: ""),
        (Title: "Settings", Url: "/ComingSoon?module=Settings", Module: "Settings")
    };

    var currentPath = Context.Request.Path.Value?.TrimEnd('/') ?? "/";
    var currentModule = Context.Request.Query["module"].ToString();

    var currentIndex = Array.FindIndex(pages, p =>
        string.Equals(
            p.Url.Split('?')[0],
            currentPath,
            StringComparison.OrdinalIgnoreCase)
        && string.Equals(
            p.Module,
            currentModule,
            StringComparison.OrdinalIgnoreCase));
}

<style>
    .page-navigation {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #e0e4ea;
    }

    .page-nav-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 110px;
        padding: 10px 18px;
        border: 1px solid #cbd2dc;
        border-radius: 6px;
        background-color: #ffffff;
        color: #123a72;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
    }

        .page-nav-button:hover {
            background-color: #edf2f8;
            text-decoration: none;
        }

    /* BLUE NEXT BUTTON */
    .page-navigation a.page-nav-button.next-button {
        background-color: #123a72 !important;
        border-color: #123a72 !important;
        color: #ffffff !important;
    }

        .page-navigation a.page-nav-button.next-button:hover {
            background-color: #1d4f91 !important;
            border-color: #1d4f91 !important;
            color: #ffffff !important;
        }

    /* Disabled Previous/Next */
    .page-nav-button.disabled {
        opacity: 0.45;
        cursor: not-allowed;
        pointer-events: none;
    }

    .page-nav-title {
        color: #667085;
        font-size: 13px;
        text-align: center;
    }

    @@media (max-width: 600px) {
        .page-nav-button {
            min-width: 0;
            padding: 9px 10px;
        }

        .page-nav-title {
            font-size: 12px;
        }
    }
</style>

@if (currentIndex >= 0)
{
    <nav class="page-navigation" aria-label="Page navigation">

     
        <a class="page-nav-button"
           href="@(currentIndex > 0 ? pages[currentIndex - 1].Url : "/Dashboard")">
            &#8249; Previous
        </a>


        <span class="page-nav-title">
            @pages[currentIndex].Title
        </span>

        @if (currentIndex < pages.Length - 1)
        {
            <a class="page-nav-button next-button"
               href="@pages[currentIndex + 1].Url">
                Next &#8250;
            </a>
        }
        else
        {
            <span class="page-nav-button next-button disabled"
                  aria-disabled="true">
                Next &#8250;
            </span>
        }

    </nav>
}
