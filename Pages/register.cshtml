@page
@model QMSApplication.Pages.RegisterModel
@{ ViewData["Title"] = "Register"; }
<div class="card p-4 mx-auto" style="max-width:680px"><h1 class="h3">Create your account</h1>
@if (Model.Verified)
{
    <div class="alert alert-success" role="status">Your OTP check is complete and your registration is submitted. Admin must approve and activate your account before you can sign in.</div>
}
else
{
    @if (Model.IsDemo) { <div class="alert alert-warning">Demo OTP mode: the next page displays your code. No email is sent and your email address is not verified.</div> }
    else { <p>Enter your details, verify the code sent to your email, then wait for Admin approval.</p> }
    @if (!Model.EmailConfigured) { <div class="alert alert-warning" role="status">Email verification is required. Admin must configure registration email delivery before registration is available.</div> }
    <form method="post"><div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <label asp-for="FirstName">First name</label><input asp-for="FirstName" class="form-control mb-3" autocomplete="given-name" required maxlength="100" />
    <label asp-for="LastName">Last name</label><input asp-for="LastName" class="form-control mb-3" autocomplete="family-name" required maxlength="99" />
    <label asp-for="Username"></label><input asp-for="Username" class="form-control mb-3" autocomplete="username" required maxlength="100" />
    <label asp-for="Email"></label><input asp-for="Email" type="email" class="form-control mb-3" autocomplete="email" required maxlength="200" />
    <label asp-for="MobileNumber">Mobile number</label><input asp-for="MobileNumber" class="form-control mb-3" autocomplete="tel" required maxlength="20" />
    <label for="Password">Password (12–128 characters)</label><input name="Password" id="Password" type="password" class="form-control mb-3" minlength="12" maxlength="128" autocomplete="new-password" required />
    <p class="text-muted">Complete the OTP step, then Admin reviews your registration and assigns your role and team.</p>
    <button class="btn btn-primary" disabled="@(!Model.EmailConfigured)">@(Model.IsDemo ? "Continue to demo OTP" : "Send verification code")</button>
    </form>
}
<a asp-page="/Login" class="mt-3">Back to sign in</a></div>
