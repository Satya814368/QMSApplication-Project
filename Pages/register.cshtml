@page
@model QMSApplication.Pages.RegisterModel

@{
    ViewData["Title"] = "New User Registration";
}

<style>


    .register-page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
    }

    .register-box {
        width: 450px;
        padding: 40px;
        background-color: white;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
    }

    .register-box h1 {
        text-align: center;
        color: #123a72;
        margin-bottom: 25px;
    }

    .form-group {
        margin-bottom: 16px;
    }

    .form-group label {
        display: block;
        margin-bottom: 6px;
        font-weight: bold;
        color: #333;
    }

    .form-group input {
        width: 100%;
        padding: 11px;
        border: 1px solid #ccc;
        border-radius: 5px;
        font-size: 15px;
        box-sizing: border-box;
    }

    .form-group input:focus {
        outline: none;
        border-color: #123a72;
    }

    .password-container {
        position: relative;
    }

    .password-container input {
        padding-right: 70px;
    }

    .show-password {
        position: absolute;
        right: 8px;
        top: 7px;
        border: none;
        background: none;
        color: #123a72;
        cursor: pointer;
        font-size: 13px;
    }

    .button {
        width: 100%;
        padding: 12px;
        border: none;
        border-radius: 5px;
        background-color: #123a72;
        color: white;
        font-size: 16px;
        cursor: pointer;
        margin-top: 8px;
    }

    .button:hover {
        background-color: #1d4f91;
    }

    .message {
        margin-bottom: 18px;
        padding: 10px;
        border-radius: 5px;
        background-color: #e8f1ff;
        color: #123a72;
        text-align: center;
    }

    .error-message {
        margin-bottom: 18px;
        padding: 10px;
        border-radius: 5px;
        background-color: #ffe6e6;
        color: #b00020;
        text-align: center;
    }

    .demo-otp {
        margin-bottom: 18px;
        padding: 12px;
        border-radius: 5px;
        background-color: #fff4cc;
        color: #6b5200;
        text-align: center;
        font-weight: bold;
    }

    .validation-message {
        color: #b00020;
        font-size: 13px;
        margin-top: 4px;
        display: block;
    }

    .links {
        text-align: center;
        margin-top: 20px;
    }

    .links a {
        color: #123a72;
        text-decoration: none;
    }

    .links a:hover {
        text-decoration: underline;
    }
</style>

<div class="register-page">

    <div class="register-box">

        <h1>New User Registration</h1>

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="message">
                @Model.Message
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="error-message">
                @Model.ErrorMessage
            </div>
        }

        @if (Model.ShowOtpSection)
        {
            <div class="demo-otp">
                Demo OTP: 123456
            </div>
        }

        @if (!Model.ShowOtpSection)
        {
            <form method="post" asp-page-handler="SendOtp">

                <div class="form-group">
                    <label asp-for="FirstName">First Name</label>

                    <input asp-for="FirstName"
                           placeholder="Enter first name" />

                    <span asp-validation-for="FirstName"
                          class="validation-message">
                    </span>
                </div>

                <div class="form-group">
                    <label asp-for="LastName">Last Name</label>

                    <input asp-for="LastName"
                           placeholder="Enter last name" />

                    <span asp-validation-for="LastName"
                          class="validation-message">
                    </span>
                </div>

                <div class="form-group">
                    <label asp-for="Username">Username</label>

                    <input asp-for="Username"
                           placeholder="Enter username" />

                    <span asp-validation-for="Username"
                          class="validation-message">
                    </span>
                </div>

                <div class="form-group">
                    <label asp-for="Password">Password</label>

                    <div class="password-container">

                        <input asp-for="Password"
                               id="password"
                               type="password"
                               placeholder="Enter password" />

                        <button type="button"
                                class="show-password"
                                onclick="togglePassword()">
                            Show
                        </button>

                    </div>

                    <span asp-validation-for="Password"
                          class="validation-message">
                    </span>
                </div>

                <div class="form-group">
                    <label asp-for="Email">Email</label>

                    <input asp-for="Email"
                           type="email"
                           placeholder="Enter email" />

                    <span asp-validation-for="Email"
                          class="validation-message">
                    </span>
                </div>

                <div class="form-group">
                    <label asp-for="MobileNumber">Mobile Number</label>

                    <input asp-for="MobileNumber"
                           placeholder="Enter mobile number" />

                    <span asp-validation-for="MobileNumber"
                          class="validation-message">
                    </span>
                </div>

                <button type="submit" class="button">
                    Continue
                </button>

            </form>
        }

        @if (Model.ShowOtpSection)
        {
            <form method="post" asp-page-handler="Register">

                <input type="hidden" asp-for="FirstName" />
                <input type="hidden" asp-for="LastName" />
                <input type="hidden" asp-for="Username" />
                <input type="hidden" asp-for="Password" />
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="MobileNumber" />

                <div class="form-group">

                    <label asp-for="Otp">
                        Enter OTP
                    </label>

                    <input asp-for="Otp"
                           placeholder="Enter 6-digit OTP"
                           maxlength="6" />

                    <span asp-validation-for="Otp"
                          class="validation-message">
                    </span>

                </div>

                <button type="submit" class="button">
                    Complete Registration
                </button>

            </form>
        }

        <div class="links">

            <a href="/Login">
                Back to Login
            </a>

        </div>

    </div>

</div>

<script>

    function togglePassword() {

        var password = document.getElementById("password");
        var button = document.querySelector(".show-password");

        if (password.type === "password") {

            password.type = "text";
            button.textContent = "Hide";

        } else {

            password.type = "password";
            button.textContent = "Show";
        }
    }

</script>
