@page
@model QMSApplication.Pages.MDCreateModel
@{
    ViewData["Title"] = "Add New Deliverable";
}
<h2>Add New Deliverable</h2>
<p><strong>@(Model.ShowTasks ? "Step 2 of 2 — Language tasks" : "Step 1 of 2 — Deliverable details")</strong></p>
<p>Fields marked <span class="text-danger">*</span> are required.</p>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<form method="post" asp-page="/MDCreate" asp-page-handler="">
    <input type="hidden" asp-for="TasksJson" />
    @if (!Model.ShowTasks)
    {
        <div class="mb-3">
            <label asp-for="Input.MilestoneName" class="form-label">Milestone Name <span class="text-danger">*</span></label>
            <input asp-for="Input.MilestoneName" class="form-control" required maxlength="200" />
            <span asp-validation-for="Input.MilestoneName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.DeliverableName" class="form-label">Deliverable Name <span class="text-danger">*</span></label>
            <input asp-for="Input.DeliverableName" class="form-control" required maxlength="200" />
            <span asp-validation-for="Input.DeliverableName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.DepartmentName" class="form-label">Department Name <span class="text-danger">*</span></label>
            <select asp-for="Input.DepartmentName" class="form-select" required>
                <option value="">-- Select Department --</option>
                @foreach (var department in new[] { "FSW", "IS", "Labeling", "SV", "S&R", "App", "FWV" })
                { <option value="@department">@department</option> }
            </select>
        </div>
        <div class="mb-3">
            <label asp-for="Input.DeliverableType" class="form-label">Deliverable Type <span class="text-danger">*</span></label>
            <select asp-for="Input.DeliverableType" class="form-select" required>
                <option value="">-- Select Type --</option>
                @foreach (var type in new[] { "UGs", "Clarification Doc", "Data Sheets", "Other" })
                { <option value="@type">@type</option> }
            </select>
        </div>
        <div class="mb-3">
            <label asp-for="Input.MilestoneTargetDate" class="form-label">Milestone Target Date <span class="text-danger">*</span></label>
            <input asp-for="Input.MilestoneTargetDate" type="date" class="form-control" required />
            <span asp-validation-for="Input.MilestoneTargetDate" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.DeliverableTargetDate" class="form-label">Deliverable Target Date <span class="text-danger">*</span></label>
            <input asp-for="Input.DeliverableTargetDate" type="date" class="form-control" required />
            <span asp-validation-for="Input.DeliverableTargetDate" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.AssignedTo" class="form-label">Assigned To <span class="text-danger">*</span></label>
            <select asp-for="Input.AssignedTo" class="form-select" required>
                <option value="">-- Select active member --</option>
                @foreach (var user in Model.ActiveUsers)
                { <option value="@user.Username">@user.FullName (@user.Username)</option> }
            </select>
        </div>
        <div class="mb-3">
            <label for="initial-status" class="form-label">Status</label>
            <input id="initial-status" class="form-control" value="Not Started" disabled />
        </div>
        <div class="mb-3">
            <label asp-for="Input.Remarks" class="form-label">Remarks</label>
            <textarea asp-for="Input.Remarks" class="form-control" maxlength="4000"></textarea>
        </div>
        <button type="submit" asp-page-handler="Next" class="btn btn-primary">Next: Tasks →</button>
        <a asp-page="/MD" class="btn btn-secondary">Cancel</a>
    }
    else
    {
        <input type="hidden" asp-for="Input.MilestoneName" />
        <input type="hidden" asp-for="Input.DeliverableName" />
        <input type="hidden" asp-for="Input.DepartmentName" />
        <input type="hidden" asp-for="Input.DeliverableType" />
        <input type="hidden" asp-for="Input.MilestoneTargetDate" asp-format="{0:yyyy-MM-dd}" />
        <input type="hidden" asp-for="Input.DeliverableTargetDate" asp-format="{0:yyyy-MM-dd}" />
        <input type="hidden" asp-for="Input.AssignedTo" />
        <input type="hidden" asp-for="Input.Remarks" />
        <div class="alert alert-light border"><strong>@Model.Input.DeliverableName</strong> · @Model.Input.MilestoneName · @Model.Input.DepartmentName</div>
        <p>Each language is one task. Enter its target numbers and default member. You can change individual target assignments after saving.</p>
        <partial name="_LanguageTaskEditor" model="Model.ActiveUsers" />
        <button type="submit" asp-page-handler="Back" class="btn btn-outline-secondary" formnovalidate>← Back</button>
        <button type="submit" class="btn btn-primary">Save Deliverable &amp; Tasks</button>
        <a asp-page="/MD" class="btn btn-secondary">Cancel</a>
    }
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/language-tasks.js" asp-append-version="true"></script>
}
