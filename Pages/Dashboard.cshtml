@page
@model QMSApplication.Pages.DashboardModel

@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Dashboard";
}

<style>
    .dashboard-content {
        background-color: white;
        padding: 24px;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .dashboard-content h1 {
        color: #123a72;
        margin-top: 0;
    }

    .dashboard-content p {
        color: #333;
    }

    .dashboard-charts {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 20px;
        margin-top: 25px;
        align-items: start;
    }

    .chart-section {
        min-width: 0;
        padding: 20px;
        background-color: #f8f9fb;
        border-radius: 10px;
        box-sizing: border-box;
    }

    .chart-section h2 {
        color: #123a72;
        font-size: 20px;
        margin-top: 0;
        margin-bottom: 20px;
    }

    .filter-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: end;
        margin-bottom: 20px;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        flex: 1 1 130px;
        min-width: 0;
    }

    .filter-group label {
        font-weight: bold;
        font-size: 13px;
        margin-bottom: 6px;
        color: #333;
    }

    .filter-group input,
    .filter-group select {
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
        padding: 9px;
        border: 1px solid #ccc;
        border-radius: 5px;
        background: white;
    }

    .filter-button {
        padding: 10px 14px;
        background-color: #123a72;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-weight: bold;
    }

    .chart-container {
        position: relative;
        width: 100%;
        height: 350px;
    }

    @@media (max-width: 1000px) {
        .dashboard-charts {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .dashboard-content {
            padding: 15px;
        }

        .chart-section {
            padding: 14px;
        }

        .chart-container {
            height: 300px;
        }
    }
</style>

<div class="dashboard-content">
    <h1>Welcome to the Dashboard</h1>
    <p>Select an option from the menu.</p>

    <div class="dashboard-charts">

        <!-- WORK COMPLETION PIE CHART -->
        <section class="chart-section">
            <h2>Work Completion Status</h2>

            <div class="chart-container">
                <canvas id="completionPieChart"></canvas>
            </div>
        </section>

        <!-- COMPLETED UG BAR CHART -->
        <section class="chart-section">
            <h2>Completed UGs by Milestone</h2>

            <form method="get" asp-page="/Dashboard">
                <div class="filter-row">
                    <div class="filter-group">
                        <label for="fromDate">From Date</label>
                        <input type="date"
                               id="fromDate"
                               name="FromDate"
                               value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <div class="filter-group">
                        <label for="toDate">To Date</label>
                        <input type="date"
                               id="toDate"
                               name="ToDate"
                               value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <div class="filter-group">
                        <label for="assignedTo">Assigned To</label>
                        <select id="assignedTo" name="AssignedTo">
                            <option value="">All Users</option>

                            @foreach (var user in Model.ActiveUsers)
                            {
                                <option value="@user.Username"
                                        selected="@(Model.AssignedTo == user.Username)">
                                    @user.FullName
                                </option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="filter-button">
                        Apply Filters
                    </button>
                </div>
            </form>

            <div class="chart-container">
                <canvas id="completedUGChart"></canvas>
            </div>
        </section>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // Work Completion Status
    const pendingCount = @Model.PendingCount;
    const inProgressCount = @Model.InProgressCount;
    const completedCount = @Model.CompletedCount;
    const deferredCount = @Model.DeferredCount;
    const cancelledCount = @Model.CancelledCount;

    const total = pendingCount + inProgressCount +
        completedCount + deferredCount + cancelledCount;

    function percentage(count) {
        return total === 0
            ? "0%"
            : ((count / total) * 100).toFixed(1) + "%";
    }

    new Chart(document.getElementById("completionPieChart"), {
        type: "pie",
        data: {
            labels: [
                "Pending", "In Progress", "Completed",
                "Deferred", "Cancelled"
            ],
            datasets: [{
                data: [
                    pendingCount, inProgressCount, completedCount,
                    deferredCount, cancelledCount
                ]
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: "bottom"
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return context.label + ": " + context.raw +
                                " (" + percentage(context.raw) + ")";
                        }
                    }
                }
            }
        }
    });

    // Completed UGs by Milestone
    const milestoneNames =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MilestoneNames));

    const milestoneCounts =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MilestoneCounts));

    new Chart(document.getElementById("completedUGChart"), {
        type: "bar",
        data: {
            labels: milestoneNames,
            datasets: [{
                label: "Completed UGs",
                data: milestoneCounts,
                backgroundColor: "rgba(54, 162, 235, 0.55)",
                borderColor: "rgb(54, 162, 235)",
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        precision: 0,
                        stepSize: 1
                    },
                    title: {

                        display: true,
                        text: "Count"
                    }
                },
                x: {
                    title: {
                        display: true,
                        text: "Milestone Name"
                    }
                }
            },
            plugins: {
                legend: {
                    display: true,
                    position: "top"
                }
            }
        }ipconfig
    });
</script>