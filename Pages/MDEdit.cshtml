@page
@model QMSApplication.Pages.MDEditModel

<!DOCTYPE html>
<html>
<head>
    <title>Edit M & D Record</title>

    <style>
            body {
                margin: 0;
                font-family: Arial, sans-serif;
                background-color: #f4f6f9;
            }

            .header {
                background-color: #123a72;
                color: white;
                padding: 18px 25px;
            }

                .header h1 {
                    margin: 0;
                }

            .content {
                padding: 25px;
            }

            .card {
                background-color: white;
                padding: 25px;
                border-radius: 8px;
                box-shadow: 0 2px 8px rgba(0,0,0,0.1);
                max-width: 1000px;
            }

            .field {
                margin-bottom: 16px;
            }

                .field label {
                    display: block;
                    font-weight: bold;
                    color: #123a72;
                    margin-bottom: 6px;
                }

                .field input,
                .field textarea,
                .field select {
                    width: 100%;
                    padding: 9px;
                    border: 1px solid #ccc;
                    border-radius: 4px;
                    font-family: Arial, sans-serif;
                }

                .field textarea {
                    min-height: 80px;
                    resize: vertical;
                }

            .button-row {
                margin-top: 20px;
            }

            .button {
                display: inline-block;
                padding: 10px 18px;
                border: none;
                border-radius: 4px;
                text-decoration: none;
                cursor: pointer;
                margin-right: 8px;
            }

            .save-button {
                background-color: #123a72;
                color: white;
            }

            .cancel-button {
                background-color: #777;
                color: white;
            }

            .message {
                margin-bottom: 15px;
                padding: 10px;
                background-color: #eef5ff;
                border: 1px solid #c8dcf5;
            }
    </style>
</head>

<body>

    <div class="header">
        <h1>Edit M & D Record</h1>
    </div>

    <div class="content">

        <div class="card">

            @if (!string.IsNullOrWhiteSpace(Model.Message))
            {
                <div class="message">
                    @Model.Message
                </div>
            }

            @if (Model.Record == null)
            {
                <p>Record not found.</p>

                <a class="button cancel-button" href="/MD">
                    Back to M & D
                </a>
            }
            else
            {
                <form method="post">
                    <input type="hidden" asp-for="Record.RecordID" />

                    <input type="hidden" asp-for="Record.ConcurrencyToken" />

                    <div class="field">
                        <label>S.No</label>
                        <input asp-for="Record.SNo" />
                    </div>
                    
<div class="field">
    <label>Department Name</label>

    <select asp-for="Record.DepartmentName" required>
        <option value="">-- Select Department --</option>
        <option value="FSW">FSW</option>
        <option value="IS">IS</option>
        <option value="Labeling">Labeling</option>
        <option value="SV">SV</option>
        <option value="S&R">S&amp;R</option>
        <option value="App">App</option>
        <option value="FWV">FWV</option>
    </select>
</div>

                    <div class="field">
                        <label>Milestone Name</label>
                        <input asp-for="Record.MilestoneName" />
                    </div>

                    <div class="field">
                        <label>Deliverable Name</label>
                        <input asp-for="Record.DeliverableName" />
                    </div>

                    <div class="field">
                        <label>Deliverable Type</label>

                        <select asp-for="Record.DeliverableType">
                            <option value="">-- Select Deliverable Type --</option>
                            <option value="UGs">UGs</option>
                            <option value="Clarification Doc">Clarification Doc</option>
                            <option value="Data Sheets">Data Sheets</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="field" id="customDeliverableTypeField">
                        <label>Custom Deliverable Type</label>
                        <input type="text"
                               id="customDeliverableType"
                               name="CustomDeliverableType"
                               placeholder="Enter custom deliverable type" />
                    </div>

                    <div class="field">
                        <label>Milestone Target Date</label>
                        <input asp-for="Record.MilestoneTargetDate" />
                    </div>

                    <div class="field">
                        <label>Deliverable Target Date</label>
                        <input asp-for="Record.DeliverableTargetDate" />
                    </div>

                    <div class="field">
                        <label>Assigned To</label>

                        <select asp-for="Record.AssignedTo">
                            <option value="">-- Select Assigned To --</option>

                            @foreach (var user in Model.AssignedToUsers)
                            {
                                <option value="@user">@user</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>Any Schedule Deviation</label>

                        <select asp-for="Record.ScheduleDeviation"
                                id="Record_ScheduleDeviation">
                            <option value="">-- Select Yes or No --</option>
                            <option value="Yes">Yes</option>
                            <option value="No">No</option>
                        </select>
                    </div>

                    <div class="field" id="activityField">
                        <label>Deliverable at Which Activity</label>

                        <input type="hidden"
                               asp-for="Record.DeliverableActivity"
                               id="Record_DeliverableActivity" />

                        <div>
                            <label style="font-weight: normal; color: black;">
                                <input type="checkbox"
                                       class="activity-checkbox"
                                       value="GN" />
                                GN
                            </label>

                            <label style="font-weight: normal; color: black;">
                                <input type="checkbox"
                                       class="activity-checkbox"
                                       value="AdHoc" />
                                AdHoc
                            </label>

                            <label style="font-weight: normal; color: black;">
                                <input type="checkbox"
                                       class="activity-checkbox"
                                       value="Agile" />
                                Agile
                            </label>

                            <label style="font-weight: normal; color: black;">
                                <input type="checkbox"
                                       class="activity-checkbox"
                                       value="Other" />
                                Other
                            </label>
                        </div>
                    </div>

                    <div class="field" id="reasonField">
                        <label>Reason for Schedule Deviation</label>
                        <textarea asp-for="Record.DeviationReason"
                                  id="Record_DeviationReason"></textarea>
                    </div>

                    <div class="field">
                        <label>Deliverable Actual Completed Date</label>
                        <input asp-for="Record.DeliverableActualCompletedDate" />
                    </div>

                    <div class="field">
                        <label>Milestone Achieved Date</label>
                        <input asp-for="Record.MilestoneAchievedDate" />
                    </div>

                    <div class="field">
                        <label>Status</label>

                        <select asp-for="Record.Status">
                            <option value="">-- Select Status --</option>
                            <option value="Not Started">Not Started</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Completed">Completed</option>
                            <option value="Deferred">Deferred</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>

                    <div class="field">
                        <label>Remarks</label>
                        <textarea asp-for="Record.Remarks"></textarea>
                    </div>

                    <div class="field">
                        <label>UGs</label>
                        <input asp-for="Record.UGs" />
                    </div>

                    <div class="button-row">

                        <button type="submit"
                                class="button save-button">
                            Save
                        </button>

                        <a class="button cancel-button"
                           href="/MD">
                            Cancel
                        </a>

                    </div>

                </form>
            }

        </div>

    </div>
    <script>
            document.addEventListener("DOMContentLoaded", function () {

                // -----------------------------
                // Deliverable Type
                // -----------------------------

                const deliverableType =
                    document.getElementById("Record_DeliverableType");

                const customField =
                    document.getElementById("customDeliverableTypeField");

                const customInput =
                    document.getElementById("customDeliverableType");

                function updateCustomField() {

                    if (deliverableType.value === "Other") {
                        customField.style.display = "block";
                        customInput.required = true;
                    }
                    else {
                        customField.style.display = "none";
                        customInput.required = false;
                        customInput.value = "";
                    }
                }

                deliverableType.addEventListener("change", updateCustomField);

                updateCustomField();


                // -----------------------------
                // Schedule Deviation
                // -----------------------------

                const scheduleDeviation =
                    document.getElementById("Record_ScheduleDeviation");

                const activityField =
                    document.getElementById("activityField");

                const reasonField =
                    document.getElementById("reasonField");

                const activityHidden =
                    document.getElementById("Record_DeliverableActivity");

                const reasonInput =
                    document.getElementById("Record_DeviationReason");

                const activityCheckboxes =
                    document.querySelectorAll(".activity-checkbox");


                // Update hidden activity value
                function updateActivityValue() {

                    const selectedActivities = [];

                    activityCheckboxes.forEach(function (checkbox) {

                        if (checkbox.checked) {
                            selectedActivities.push(checkbox.value);
                        }

                    });

                    activityHidden.value = selectedActivities.join(", ");
                }


                // Load existing activities when editing
                function loadExistingActivities() {

                    const existingValue =
                        activityHidden.value || "";

                    const existingActivities =
                        existingValue
                            .split(",")
                            .map(function (item) {
                                return item.trim().toLowerCase();
                            });

                    activityCheckboxes.forEach(function (checkbox) {

                        checkbox.checked =
                            existingActivities.includes(
                                checkbox.value.toLowerCase()
                            );

                    });
                }


                // Show/hide fields based on Yes/No
                function updateScheduleDeviation() {

                    if (scheduleDeviation.value === "Yes") {

                        activityField.style.display = "block";
                        reasonField.style.display = "block";

                        reasonInput.required = true;

                    }
                    else if (scheduleDeviation.value === "No") {

                        activityField.style.display = "none";
                        reasonField.style.display = "none";

                        reasonInput.required = false;

                        activityCheckboxes.forEach(function (checkbox) {
                            checkbox.checked = false;
                        });

                        activityHidden.value = "N/A";
                        reasonInput.value = "N/A";
                    }
                    else {

                        activityField.style.display = "none";
                        reasonField.style.display = "none";

                        reasonInput.required = false;
                    }
                }


                // When activity checkbox changes
                activityCheckboxes.forEach(function (checkbox) {

                    checkbox.addEventListener("change", function () {
                        updateActivityValue();
                    });

                });


                // When Yes/No changes
                scheduleDeviation.addEventListener(
                    "change",
                    updateScheduleDeviation
                );


                // Load existing values first
                loadExistingActivities();

                // Then set correct display
                updateScheduleDeviation();

            });
    </script>
</body>
</html>