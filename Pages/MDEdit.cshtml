@page
@model QMSApplication.Pages.MDEditModel
@{ ViewData["Title"]="Edit deliverable"; }
<div class="qms-form-card"><h1 class="h3">Edit @Model.Id</h1><div asp-validation-summary="All" class="text-danger"></div>
<form method="post"><input type="hidden" asp-for="Id"/><input type="hidden" asp-for="Version"/><div class="row g-3">
<div class="col-md-6"><label asp-for="Input.MilestoneName">Milestone *</label><input asp-for="Input.MilestoneName" class="form-control" required/></div>
<div class="col-md-6"><label asp-for="Input.DeliverableName">Deliverable *</label><input asp-for="Input.DeliverableName" class="form-control" required/></div>
<div class="col-md-6"><label asp-for="Input.DepartmentName">Department display name *</label><input asp-for="Input.DepartmentName" class="form-control" required/></div>
<div class="col-md-6"><label asp-for="Input.DeliverableType">Type *</label><select asp-for="Input.DeliverableType" class="form-select">@foreach(var type in new[]{"UGs","Clarification Doc","Data Sheets","Other"}){<option>@type</option>}</select></div>
<div class="col-md-6"><label asp-for="Input.MilestoneTargetDate">Milestone target *</label><input asp-for="Input.MilestoneTargetDate" type="date" class="form-control" required/></div>
<div class="col-md-6"><label asp-for="Input.DeliverableTargetDate">Deliverable target *</label><input asp-for="Input.DeliverableTargetDate" type="date" class="form-control" required/></div>
<div class="col-md-6"><label asp-for="Input.AssignedTo">Assigned to *</label><select asp-for="Input.AssignedTo" class="form-select" required><option value="">Select approved member</option>@foreach(var member in Model.Assignees){<option value="@member.Username">@member.FullName (@member.Username)</option>}</select></div>
<div class="col-md-6"><label asp-for="Input.Status">Status *</label><select asp-for="Input.Status" class="form-select">@foreach(var status in new[]{"Not Started","In Progress","Completed","Deferred","Cancelled"}){<option>@status</option>}</select></div>
<div class="col-md-6"><label asp-for="Input.DeliverableActualCompletedDate">Actual completion date</label><input asp-for="Input.DeliverableActualCompletedDate" type="date" class="form-control"/></div>
<div class="col-12"><label asp-for="Input.Remarks">Remarks</label><textarea asp-for="Input.Remarks" class="form-control"></textarea></div></div><p class="text-muted mt-3">Owning team and security department are controlled through My Team, separately from the department display name.</p><button class="btn btn-primary">Save changes</button><a asp-page="/md" class="btn btn-secondary">Cancel</a></form></div>
