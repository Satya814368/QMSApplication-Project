@page
@model QMSApplication.Pages.ResetPasswordModel
@{ ViewData["Title"] = "Choose new password"; }
<div class="card p-4"><h1 class="h3">Choose your new password</h1>
@if (Model.Done) { <p>Password updated. Sign in using your new password.</p><a asp-page="/Login">Sign in</a> }
else { <form method="post"><div asp-validation-summary="All" class="text-danger"></div><input type="hidden" asp-for="Token" /><label for="Password">New password (12–128 characters)</label><input type="password" name="Password" id="Password" class="form-control mb-3" minlength="12" maxlength="128" autocomplete="new-password" required /><label for="ConfirmPassword">Confirm password</label><input type="password" name="ConfirmPassword" id="ConfirmPassword" class="form-control mb-3" autocomplete="new-password" required /><button class="btn btn-primary">Save password</button></form> }</div>
