@page
@model QMSApplication.Pages.ForgotPasswordModel
@{ ViewData["Title"] = "Password help"; }
<div class="card p-4"><h1 class="h3">Reset your password</h1><p>Admin verifies your identity and provides a reset link.</p>
@if (Model.Message != null) { <div class="alert alert-info" role="status">@Model.Message</div> }
<form method="post"><label asp-for="UsernameOrEmail">Username or email</label><input asp-for="UsernameOrEmail" class="form-control mb-3" maxlength="200" required /><button class="btn btn-primary">Request password help</button></form><a asp-page="/Login" class="mt-3">Back to sign in</a></div>
