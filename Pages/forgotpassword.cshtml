@page
@model QMSApplication.Pages.ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
}

<style>


    .forgot-page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
    }

    .forgot-box {
        width: 420px;
        padding: 40px;
        background-color: white;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
    }

    .forgot-box h1 {
        text-align: center;
        color: #123a72;
        margin-bottom: 25px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-group label {
        display: block;
        margin-bottom: 7px;
        font-weight: bold;
        color: #333;
    }

    .form-group input {
        width: 100%;
        padding: 11px;
        border: 1px solid #ccc;
        border-radius: 5px;
        font-size: 15px;
        box-sizing: border-box;
    }

    .form-group input:focus {
        outline: none;
        border-color: #123a72;
    }

    .button {
        width: 100%;
        padding: 12px;
        border: none;
        border-radius: 5px;
        background-color: #123a72;
        color: white;
        font-size: 16px;
        cursor: pointer;
        margin-top: 5px;
    }

    .button:hover {
        background-color: #1d4f91;
    }

    .message {
        margin-bottom: 18px;
        padding: 10px;
        border-radius: 5px;
        background-color: #e8f1ff;
        color: #123a72;
        text-align: center;
    }

    .error-message {
        margin-bottom: 18px;
        padding: 10px;
        border-radius: 5px;
        background-color: #ffe6e6;
        color: #b00020;
        text-align: center;
    }

    .demo-otp {
        margin-bottom: 18px;
        padding: 12px;
        border-radius: 5px;
        background-color: #fff4cc;
        color: #6b5200;
        text-align: center;
        font-weight: bold;
    }

    .validation-message {
        color: #b00020;
        font-size: 13px;
        margin-top: 4px;
        display: block;
    }

    .links {
        text-align: center;
        margin-top: 20px;
    }

    .links a {
        color: #123a72;
        text-decoration: none;
    }

    .links a:hover {
        text-decoration: underline;
    }
</style>

<div class="forgot-page">

    <div class="forgot-box">

        <h1>Forgot Password</h1>

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="message">
                @Model.Message
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="error-message">
                @Model.ErrorMessage
            </div>
        }

        @if (!Model.ShowResetSection)
        {
            <form method="post" asp-page-handler="Verify">

                <div class="form-group">

                    <label asp-for="UsernameOrEmail">
                        Username or Email
                    </label>

                    <input asp-for="UsernameOrEmail"
                           placeholder="Enter username or email" />

                    <span asp-validation-for="UsernameOrEmail"
                          class="validation-message">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="MobileNumber">
                        Mobile Number
                    </label>

                    <input asp-for="MobileNumber"
                           placeholder="Enter mobile number" />

                    <span asp-validation-for="MobileNumber"
                          class="validation-message">
                    </span>

                </div>

                <button type="submit" class="button">
                    Verify
                </button>

            </form>
        }

        @if (Model.ShowResetSection)
        {
            <div class="demo-otp">
                Demo OTP: 123456
            </div>

            <form method="post" asp-page-handler="Reset">

                <input type="hidden"
                       asp-for="UsernameOrEmail" />

                <input type="hidden"
                       asp-for="MobileNumber" />

                <div class="form-group">

                    <label asp-for="Otp">
                        OTP
                    </label>

                    <input asp-for="Otp"
                           placeholder="Enter OTP"
                           maxlength="6" />

                    <span asp-validation-for="Otp"
                          class="validation-message">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="NewPassword">
                        New Password
                    </label>

                    <input asp-for="NewPassword"
                           type="password"
                           placeholder="Enter new password" />

                    <span asp-validation-for="NewPassword"
                          class="validation-message">
                    </span>

                </div>

                <button type="submit" class="button">
                    Reset Password
                </button>

            </form>
        }

        <div class="links">

            <a href="/Login">
                Back to Login
            </a>

        </div>

    </div>

</div>
