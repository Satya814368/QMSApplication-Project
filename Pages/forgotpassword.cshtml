@page
@model QMSApplication.Pages.ForgotPasswordModel
@{ ViewData["Title"] = "Forgot password"; }
<div class="card p-4"><h1 class="h3">Forgot password</h1>
<p>Enter the email address registered to your account. If eligible, you will receive a six-digit code valid for five minutes.</p>
@if (Model.Error != null) { <div class="alert alert-danger">@Model.Error</div> }
<form method="post"><label asp-for="Email">Registered email address</label>
<input asp-for="Email" type="email" class="form-control mb-3" maxlength="200" autocomplete="email" required />
<button class="btn btn-primary" type="submit">Send verification code</button></form>
<a asp-page="/Login" class="mt-3">Back to sign in</a></div>
