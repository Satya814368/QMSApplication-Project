@page
@model QMSApplication.Pages.ForgotPasswordModel
@{ ViewData["Title"] = "Forgot password"; }
<div class="card p-4"><h1 class="h3">Reset your password</h1>
<p>Enter your registered email address. We will send a six-digit OTP so you can choose a new password.</p>
@if (!Model.Ready) { <div class="alert alert-warning">Email password recovery is not configured. Contact the administrator.</div> }
@if (Model.Error != null) { <div class="alert alert-danger" role="alert">@Model.Error</div> }
<form method="post"><div asp-validation-summary="All" class="text-danger"></div>
<label asp-for="Email">Registered email address</label>
<input asp-for="Email" type="email" class="form-control mb-3" maxlength="200" autocomplete="email" required />
<button class="btn btn-primary" type="submit" disabled="@(!Model.Ready)">Send OTP</button></form>
<p class="small text-muted mt-3 mb-0">The OTP expires in 5 minutes. Admin approval is still required for new accounts.</p>
<a asp-page="/Login" class="mt-3">Back to sign in</a></div>
