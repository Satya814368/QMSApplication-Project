@page
@model QMSApplication.Pages.ChangePasswordModel
@{ ViewData["Title"] = "Change Password"; }
<div class="qms-profile-page qms-profile-password card p-4">
<h1 class="h3">Change Password</h1>
@if (Model.Done)
{
    <div class="alert alert-success" role="status">Your password has been updated. Your existing sessions have been signed out.</div>
    <a asp-page="/Login" class="btn btn-primary align-self-start">Sign in with your new password</a>
}
else
{
    <p>Verify an OTP sent to your registered email: <strong>@Model.MaskedEmail</strong>.</p>
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    @if (TempData["ProfileOtpSent"] is string sent) { <div class="alert alert-info" role="status">@sent</div> }
    @if (!Model.CanSend) { <div class="alert alert-warning">Contact Admin to check your registered email and email delivery configuration.</div> }
    @if (Model.HasRequest)
    {
        <form method="post" asp-page-handler="Verify">
            <label for="Code" class="form-label">Email OTP</label><input name="Code" id="Code" class="form-control mb-3" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required />
            <label for="Password" class="form-label">New password (12–128 characters)</label><input name="Password" id="Password" type="password" class="form-control mb-3" minlength="12" maxlength="128" autocomplete="new-password" required />
            <label for="ConfirmPassword" class="form-label">Confirm new password</label><input name="ConfirmPassword" id="ConfirmPassword" type="password" class="form-control mb-3" minlength="12" maxlength="128" autocomplete="new-password" required />
            <button class="btn btn-primary" type="submit">Verify OTP &amp; change password</button>
        </form>
    }
    <form method="post" asp-page-handler="Send" class="mt-3"><button class="btn @(Model.HasRequest ? "btn-outline-primary" : "btn-primary")" type="submit" disabled="@(!Model.CanSend)">@(Model.HasRequest ? "Request another OTP" : "Send OTP")</button></form>
    <p class="text-muted small mt-3">Codes expire after 5 minutes, with up to 5 attempts. Wait 60 seconds between requests; up to 3 codes per hour. A new code replaces earlier codes. Changing your password signs out your existing sessions.</p>
    <a asp-page="/MyProfile" class="mt-2">Back to My Profile</a>
}
</div>
