@page
@model QMSApplication.Pages.ReportsModel
@{ ViewData["Title"] = "Reports & Analytics"; }
<style>
.pmt-reports{width:100%;max-width:none;margin:0}.pmt-reports .report-heading{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}.pmt-reports .report-tabs{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.pmt-reports .report-tabs a{padding:10px 15px;border:1px solid #dbe3ed;border-radius:9px;text-decoration:none;color:#344563}.pmt-reports .report-tabs a.active{background:#164a9e;color:white;border-color:#164a9e}.pmt-reports .metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:12px 0}.pmt-reports .metric{border:1px solid #e2e8f0;border-radius:12px;background:white;padding:14px}.pmt-reports .metric strong{display:block;font-size:1.7rem;color:#153c7a}.pmt-reports .muted{color:#64748b}.pmt-reports .report-panel{background:white;border:1px solid #e2e8f0;border-radius:12px;padding:14px;margin-top:12px}.pmt-reports .report-filters{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;align-items:end}.pmt-reports .report-filters label{display:block;font-size:.85rem;font-weight:600;margin-bottom:5px}.pmt-reports .bar{height:9px;border-radius:12px;background:#e2e8f0;overflow:hidden;min-width:65px}.pmt-reports .bar span{height:100%;display:block;background:#2563eb}.pmt-reports .table{font-size:.91rem}.pmt-reports .table td{vertical-align:middle}.pmt-reports .empty{padding:12px;text-align:center;color:#64748b}@@media(max-width:900px){.pmt-reports .metric-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.pmt-reports .report-filters{grid-template-columns:repeat(2,minmax(0,1fr))}}@@media(max-width:540px){.pmt-reports .metric-grid{grid-template-columns:1fr}}
.pmt-reports .pmt-chart{display:flex;gap:12px;align-items:end;min-height:0;padding:8px 8px 0;border-bottom:1px solid #cbd5e1;overflow-x:auto}.pmt-reports .pmt-chart-group{flex:1;min-width:66px;text-align:center;display:flex;flex-direction:column;gap:5px}.pmt-reports .pmt-bars{height:120px;display:flex;justify-content:center;align-items:end;gap:4px}.pmt-reports .pmt-bars span{display:block;width:35%;min-height:0;border-radius:5px 5px 0 0}.pmt-reports .pmt-bar-plan{background:#397ce6}.pmt-reports .pmt-bar-actual{background:#2f9d67}@@media print{.pmt-reports .report-tabs,.pmt-reports .report-filters,.pmt-reports .btn{display:none!important}}
</style>
<div class="pmt-reports">
  <div class="report-heading"><div><h1 class="h3 mb-1">Reports &amp; Analytics</h1><p class="muted mb-0">Delivery, workflow, timesheets and audit insights · @Model.ScopeLabel</p></div>
  @if(Model.Section == "overview" || Model.Section == "deliverables" || Model.Section == "workflow" || Model.Section == "timesheets" || Model.Section == "audit") {<a class="btn btn-outline-primary" asp-page-handler="Export" asp-route-Section="@(Model.Section == "overview" ? "deliverables" : Model.Section)" asp-route-Search="@Model.Search" asp-route-Status="@Model.Status" asp-route-From="@Model.From" asp-route-To="@Model.To">Export CSV</a>}</div>
  <nav class="report-tabs" aria-label="Report categories">
  @foreach(var tab in new[]{("overview","Overview"),("deliverables","Deliverables"),("workflow","14-Step Workflow"),("timesheets","Timesheets"),("teams","Teams"),("delays","Delays"),("management","Management Summary"),("audit","Audit History"),("risks","Risks & Issues")}) {<a asp-page="/Reports" asp-route-Section="@tab.Item1" asp-route-Search="@Model.Search" asp-route-Status="@Model.Status" asp-route-From="@Model.From" asp-route-To="@Model.To" class="@(Model.Section == tab.Item1 ? "active" : "")">@tab.Item2</a>}
  </nav>
  <form method="get" class="report-panel report-filters"><input type="hidden" name="Section" value="@Model.Section"/>@if(Model.Section == "overview"){<input type="hidden" name="TrendPeriod" value="@Model.TrendPeriod"/><input type="hidden" name="TrendFrom" value="@(Model.TrendFrom?.ToString("yyyy-MM-dd"))"/><input type="hidden" name="TrendTo" value="@(Model.TrendTo?.ToString("yyyy-MM-dd"))"/>}<div><label for="reportSearch">Search</label><input id="reportSearch" name="Search" value="@Model.Search" class="form-control" maxlength="200" placeholder="@(Model.Section == "risks" ? "Title or description" : "Record, name, assignee")"/></div><div><label for="reportStatus">Status</label><select id="reportStatus" name="Status" class="form-select"><option value="">All statuses</option>@foreach(var s in (Model.Section == "risks" ? new[]{"Open","In Progress","Resolved","Closed"} : new[]{"Completed","In Progress","Pending","Not Started","Cancelled"})){<option value="@s" selected="@(Model.Status == s)">@s</option>}</select></div><div><label for="reportFrom">From target date</label><input id="reportFrom" name="From" type="date" value="@(Model.From?.ToString("yyyy-MM-dd"))" class="form-control"/></div><div><label for="reportTo">To target date</label><input id="reportTo" name="To" type="date" value="@(Model.To?.ToString("yyyy-MM-dd"))" class="form-control"/></div><div><button type="submit" class="btn btn-primary w-100">Apply Filters</button></div></form>
  <div asp-validation-summary="All" class="text-danger"></div>
  @if(Model.Section == "overview" || Model.Section == "deliverables" || Model.Section == "workflow") {
  <div class="metric-grid"><div class="metric"><span class="muted">Deliverables</span><strong>@Model.Total</strong></div><div class="metric"><span class="muted">Completed</span><strong>@Model.Completed</strong></div><div class="metric"><span class="muted">Overdue</span><strong>@Model.Overdue</strong></div><div class="metric"><span class="muted">Completion rate</span><strong>@(Model.Total == 0 ? 0 : Math.Round(Model.Completed * 100m / Model.Total, 1))%</strong></div></div>
  }
  @if(Model.Section == "overview") {
  <div class="report-panel"><h2 class="h5">Deliverable status breakdown</h2>@if(Model.StatusSummary.Count == 0){<p class="empty">No matching records.</p>}else{<div class="row g-3">@foreach(var item in Model.StatusSummary){<div class="col-md-6"><div class="d-flex justify-content-between"><span>@item.Name</span><strong>@item.Count</strong></div><div class="bar"><span style="width:@(Model.Total == 0 ? 0 : item.Count * 100m / Model.Total)%"></span></div></div>}</div>}</div>
  <div class="report-panel"><h2 class="h5">Target workflow summary</h2><p>Total targets: <strong>@Model.TargetCount</strong> · All 14 steps complete: <strong>@Model.CompletedTargets</strong></p><a asp-page="/Reports" asp-route-Section="workflow" class="btn btn-outline-primary btn-sm">View target details</a></div>
  }
  @if(Model.Section == "overview") {
  <div class="report-panel"><h2 class="h5">Planned vs actual completions</h2><p class="muted small">Counts by recorded target and actual completion dates, not a historical baseline snapshot.</p>
  <form method="get" class="d-flex flex-wrap align-items-end gap-2 mb-3" id="trendFilter">
    <input type="hidden" name="Section" value="overview"/>
    <input type="hidden" name="Search" value="@Model.Search"/>
    <input type="hidden" name="Status" value="@Model.Status"/>
    <input type="hidden" name="From" value="@(Model.From?.ToString("yyyy-MM-dd"))"/>
    <input type="hidden" name="To" value="@(Model.To?.ToString("yyyy-MM-dd"))"/>
    <div><label for="trendPeriod">Period</label><select class="form-select" id="trendPeriod" name="TrendPeriod">
      @foreach(var option in new[]{("3","Last 3 months"),("6","Last 6 months"),("12","Last 12 months"),("year","Current year"),("prev","Previous year"),("custom","Custom date range")}) {<option value="@option.Item1" selected="@(Model.TrendPeriod == option.Item1)">@option.Item2</option>}
    </select></div>
    <div><label for="trendFrom">Custom from</label><input class="form-control" type="date" id="trendFrom" name="TrendFrom" value="@(Model.TrendFrom?.ToString("yyyy-MM-dd"))"/></div>
    <div><label for="trendTo">Custom to</label><input class="form-control" type="date" id="trendTo" name="TrendTo" value="@(Model.TrendTo?.ToString("yyyy-MM-dd"))"/></div>
    <button class="btn btn-primary" type="submit">Apply period</button>
  </form>
  <script> (function(){const p=document.getElementById('trendPeriod'), fields=[document.getElementById('trendFrom'),document.getElementById('trendTo')]; function sync(){fields.forEach(f=>{f.disabled=p.value!=='custom';f.required=p.value==='custom';});} p.addEventListener('change',sync);sync();})(); </script>
  @if(Model.TrendError != null){<p class="text-danger">@Model.TrendError</p>}
  else {<p class="muted small">@Model.TrendRange</p>}
  <div class="pmt-chart">@foreach(var r in Model.CompletionTrend){<div class="pmt-chart-group"><div class="pmt-bars"><span class="pmt-bar-plan" title="Planned: @r.Planned" style="height:@(Math.Max(0, r.Planned * 100.0 / Math.Max(1, Model.CompletionTrend.Max(x => Math.Max(x.Planned,x.Actual)))))%"></span><span class="pmt-bar-actual" title="Actual: @r.Actual" style="height:@(Math.Max(0, r.Actual * 100.0 / Math.Max(1, Model.CompletionTrend.Max(x => Math.Max(x.Planned,x.Actual)))))%"></span></div><small>@r.Period</small><small>@r.Planned / @r.Actual</small></div>}</div><p class="small muted">Blue = planned · Green = actual</p></div>
  <div class="report-panel"><h2 class="h5">14-step workflow distribution</h2><div class="pmt-chart">@foreach(var r in Model.WorkflowStages){<div class="pmt-chart-group"><div class="pmt-bars"><span class="pmt-bar-plan" title="@r.Name: @r.Count" style="height:@(Math.Max(3, r.Count * 100.0 / Math.Max(1, Model.WorkflowStages.Max(x => x.Count))))%"></span></div><small>@r.Name</small><small>@r.Count</small></div>}</div><p class="muted small">Grouped by number of completed steps. Individual step details are in 14-Step Workflow.</p></div>
  <div class="report-panel"><h2 class="h5">Department workload comparison</h2><p class="muted small">Only departments within your authorized report scope are included.</p><div class="table-responsive"><table class="table"><thead><tr><th>Department</th><th>Deliverables</th><th>Completed</th><th>Overdue</th><th>Completion</th></tr></thead><tbody>@foreach(var r in Model.TeamSummary){<tr><td>@r.Name</td><td>@r.Deliverables</td><td>@r.Completed</td><td>@r.Overdue</td><td><div class="bar"><span style="width:@(r.Deliverables == 0 ? 0 : r.Completed * 100.0 / r.Deliverables)%"></span></div></td></tr>}</tbody></table></div></div>
  }
  @if(Model.Section == "teams") {
  <div class="report-panel"><h2 class="h5">Department delivery performance</h2><p class="muted">Department-level summary of authorized deliverables. Employee-level utilization is available in Timesheets.</p><div class="table-responsive"><table class="table"><thead><tr><th>Department</th><th>Total</th><th>Completed</th><th>Overdue</th><th>Completion %</th></tr></thead><tbody>@foreach(var r in Model.TeamSummary){<tr><td>@r.Name</td><td>@r.Deliverables</td><td>@r.Completed</td><td>@r.Overdue</td><td>@(r.Deliverables == 0 ? 0 : Math.Round(r.Completed * 100m / r.Deliverables, 1))%</td></tr>}</tbody></table></div></div>
  <div class="report-panel"><h2 class="h5">Time allocation</h2><p>Total logged: <strong>@(Math.Round(Model.TotalLoggedMinutes / 60m, 1)) hours</strong></p>@foreach(var r in Model.TimeKinds){<div class="d-flex justify-content-between"><span>@r.Name</span><strong>@(Math.Round(r.Minutes / 60m, 1)) h</strong></div><div class="bar mb-2"><span style="width:@(Model.TotalLoggedMinutes == 0 ? 0 : r.Minutes * 100m / Model.TotalLoggedMinutes)%"></span></div>}</div>
  }
  @if(Model.Section == "delays") {
  <div class="report-panel"><h2 class="h5">Overdue deliverables (@Model.DelayedCount)</h2><p class="muted">Target date is past and status is neither Completed nor Cancelled. Up to 200 records shown.</p><div class="table-responsive"><table class="table"><thead><tr><th>Record</th><th>Deliverable</th><th>Assignee</th><th>Due date</th><th>Status</th><th>Deviation reason</th></tr></thead><tbody>@foreach(var r in Model.DelayedRecords){<tr><td>@r.RecordID</td><td>@r.DeliverableName</td><td>@r.DisplayAssignedTo</td><td>@r.DeliverableTargetDate</td><td>@r.Status</td><td>@r.DeviationReason</td></tr>}</tbody></table></div></div>
  }
  @if(Model.Section == "management") {
  <article class="management-review">
    <header class="report-panel">
      <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div><p class="muted small mb-1">PROJECT MANAGEMENT TOOL · MANAGEMENT REVIEW</p><h2 class="h4 mb-2">Delivery &amp; operational review</h2><p class="mb-1"><strong>Scope:</strong> @Model.ScopeLabel</p><p class="mb-1"><strong>Target-date filter:</strong> @(Model.From?.ToString("dd MMM yyyy") ?? "All dates") – @(Model.To?.ToString("dd MMM yyyy") ?? "All dates")</p><p class="muted small mb-0">Generated (UTC): @DateTime.UtcNow.ToString("dd MMM yyyy HH:mm")</p></div>
        <button class="btn btn-outline-primary" type="button" onclick="window.print()">Print / Save as PDF</button>
      </div>
      <p class="muted small mt-3 mb-0">This is a live, filtered operational snapshot, not a formally approved meeting record. Date filters select deliverables by target date; timesheet figures use entry start dates.</p>
    </header>
    <section class="report-panel"><h3 class="h5">1. Executive assessment</h3>
      <p>@Model.ManagementAssessment</p>
      <div class="row g-3">
        <div class="col-md-4"><strong>@Model.Completed / @Model.Total</strong><div class="muted small">Completed deliverables in scope</div></div>
        <div class="col-md-4"><strong>@Model.Overdue</strong><div class="muted small">Overdue deliverables requiring review</div></div>
        <div class="col-md-4"><strong>@Model.PendingApprovals</strong><div class="muted small">Pending timesheet approvals in authorized scope</div></div>
      </div>
    </section>
    <section class="report-panel"><h3 class="h5">2. Delivery achievements</h3>
      <p><strong>@Model.Completed</strong> deliverables are currently marked completed. <strong>@Model.CompletedTargets</strong> of <strong>@Model.TargetCount</strong> tracked targets have all 14 steps completed; <strong>@Model.CancelledTargets</strong> targets are cancelled.</p>
      <p class="muted small mb-0">Completion counts describe current status within the target-date filter, not necessarily work finished during that calendar period.</p>
    </section>
    <section class="report-panel"><h3 class="h5">3. Exceptions requiring management attention</h3>
      @if(Model.DelayedCount == 0){<p>No overdue deliverables were found in the selected scope.</p>}
      else {<p><strong>@Model.DelayedCount</strong> overdue deliverables. Showing the earliest 20; open Delays for further details.</p>
      <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Record</th><th>Deliverable</th><th>Assigned to</th><th>Due</th><th>Deviation / explanation</th></tr></thead><tbody>
      @foreach(var r in Model.DelayedRecords.Take(20)){<tr><td>@r.RecordID</td><td>@r.DeliverableName</td><td>@r.DisplayAssignedTo</td><td>@r.DeliverableTargetDate?.ToString("dd MMM yyyy")</td><td>@(string.IsNullOrWhiteSpace(r.DeviationReason) ? "Not recorded" : r.DeviationReason)</td></tr>}
      </tbody></table></div>}
      <p class="mt-3 mb-0">Pending timesheet approvals: <strong>@Model.PendingApprovals</strong>. Review the Timesheets section for entry details.</p>
    </section>
    <section class="report-panel"><h3 class="h5">4. Capacity and time allocation</h3>
      <p><strong>@(Math.Round(Model.TotalLoggedMinutes / 60m, 1)) hours</strong> logged across authorized entries; <strong>@Model.ApprovedTimeEntries</strong> entries approved.</p>
      <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Activity</th><th>Logged hours</th></tr></thead><tbody>@foreach(var k in Model.TimeKinds){<tr><td>@k.Name</td><td>@(Math.Round(k.Minutes / 60m, 1))</td></tr>}</tbody></table></div>
      <p class="muted small mb-0">Logged time is not an employee productivity score; working-day capacity and approved leave are not calculated here.</p>
    </section>
    <section class="report-panel"><h3 class="h5">5. Follow-up and management decisions</h3>
      <p class="muted">The following are review prompts derived from live records, not recorded approvals or assigned corrective actions.</p>
      <div class="table-responsive"><table class="table"><thead><tr><th>Review item</th><th>Evidence</th><th>Suggested follow-up</th><th>Decision / owner / due date</th></tr></thead><tbody>
      <tr><td>Overdue deliverables</td><td>@Model.DelayedCount open overdue</td><td>Confirm causes and revised dates with responsible assignees</td><td>To be recorded in management meeting</td></tr>
      <tr><td>Timesheet approvals</td><td>@Model.PendingApprovals pending</td><td>Review submitted entries with authorized approvers</td><td>To be recorded in management meeting</td></tr>
      <tr><td>Workflow completion</td><td>@Model.CompletedTargets / @Model.TargetCount targets complete</td><td>Review unfinished target steps and external dependencies</td><td>To be recorded in management meeting</td></tr>
      </tbody></table></div>
      <p class="muted small mb-0">Meeting decisions, named owners, commitments and approvals are not stored by this report. Record them in an approved management review register before using this document as formal audit evidence.</p>
    </section>
  </article>
  }
  @if(Model.Section == "risks") {<div class="report-panel"><h2 class="h5">Risks & Issues</h2><p>No structured risk or issue register is mapped in this project's database models. This report cannot show live risk scores or corrective actions until those records are integrated. Do not use fabricated risk data for audits.</p></div>}
  @if(Model.Section == "overview" || Model.Section == "deliverables") {
  <div class="report-panel"><h2 class="h5">Deliverable details</h2><p class="muted">@Model.FilteredCount matching records · Page @Model.PageNumber of @Model.PageCount</p><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Record</th><th>Deliverable</th><th>Department</th><th>Assigned to</th><th>Target date</th><th>Actual date</th><th>Status</th></tr></thead><tbody>@foreach(var r in Model.Records){<tr><td><a asp-page="/MDView" asp-route-id="@r.RecordID">@r.RecordID</a></td><td>@r.DeliverableName</td><td>@r.DepartmentName</td><td>@r.DisplayAssignedTo</td><td>@r.DeliverableTargetDate?.ToString("dd-MMM-yyyy")</td><td>@r.DeliverableActualCompletedDate?.ToString("dd-MMM-yyyy")</td><td>@r.Status</td></tr>}</tbody></table>@if(Model.Records.Count == 0){<p class="empty">No deliverables found for these filters.</p>}</div><nav class="d-flex gap-2">@if(Model.PageNumber > 1){<a class="btn btn-outline-primary btn-sm" asp-route-Section="@Model.Section" asp-route-Search="@Model.Search" asp-route-Status="@Model.Status" asp-route-From="@Model.From" asp-route-To="@Model.To" asp-route-PageNumber="@(Model.PageNumber-1)">Previous</a>}@if(Model.PageNumber < Model.PageCount){<a class="btn btn-outline-primary btn-sm" asp-route-Section="@Model.Section" asp-route-Search="@Model.Search" asp-route-Status="@Model.Status" asp-route-From="@Model.From" asp-route-To="@Model.To" asp-route-PageNumber="@(Model.PageNumber+1)">Next</a>}</nav></div>
  }
  @if(Model.Section == "workflow") {
  <div class="report-panel"><h2 class="h5">Language and target workflow</h2><p class="muted">Showing up to 500 targets. Export CSV for up to 10,000 rows.</p><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Record</th><th>Language</th><th>Target</th><th>Assignee</th><th>Current stage</th><th>Progress</th></tr></thead><tbody>@foreach(var r in Model.Workflow){<tr><td>@r.Record</td><td>@r.Language</td><td>@r.Target</td><td>@r.Assignee</td><td>@r.Stage</td><td><div class="d-flex align-items-center gap-2"><span>@r.Percent%</span><div class="bar flex-grow-1"><span style="width:@r.Percent%"></span></div></div></td></tr>}</tbody></table>@if(Model.Workflow.Count == 0){<p class="empty">No targets found.</p>}</div></div>
  }
  @if(Model.Section == "timesheets") {
  <div class="metric-grid"><div class="metric"><span class="muted">Logged hours</span><strong>@(Math.Round(Model.LoggedMinutes / 60m, 1))h</strong></div><div class="metric"><span class="muted">Pending approvals</span><strong>@Model.PendingApprovals</strong></div></div>
  <div class="report-panel"><h2 class="h5">Time allocation by activity</h2>@foreach(var k in Model.TimeKinds){<div class="d-flex justify-content-between"><span>@k.Name</span><strong>@(Math.Round(k.Minutes / 60m, 1)) hours</strong></div><div class="bar mb-2"><span style="width:@(Model.LoggedMinutes == 0 ? 0 : k.Minutes * 100m / Model.LoggedMinutes)%"></span></div>}<p>Approved entries: @Model.ApprovedTimeEntries</p></div>
  <div class="report-panel"><h2 class="h5">Timesheet entries</h2><p class="muted">Showing latest 200 entries. Dates are stored in UTC.</p><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Employee</th><th>Type</th><th>Description</th><th>Start (UTC)</th><th>Hours</th><th>Status</th></tr></thead><tbody>@foreach(var r in Model.Timesheets){<tr><td>@r.Employee</td><td>@r.Kind</td><td>@r.Description</td><td>@r.StartUtc.ToString("dd-MMM-yyyy HH:mm")</td><td>@(Math.Round(r.Minutes / 60m, 2))</td><td>@r.Status</td></tr>}</tbody></table>@if(Model.Timesheets.Count == 0){<p class="empty">No time entries found.</p>}</div></div>
  }
  @if(Model.Section == "audit") {
  <div class="report-panel"><h2 class="h5">Deliverable audit history</h2><p class="muted">Latest 200 changes for deliverables you are permitted to view. Guests cannot view audit events.</p><div class="table-responsive"><table class="table table-striped"><thead><tr><th>UTC timestamp</th><th>Actor</th><th>Record</th><th>Action</th><th>Changed field</th></tr></thead><tbody>@foreach(var r in Model.Audits){<tr><td>@r.AtUtc.ToString("dd-MMM-yyyy HH:mm")</td><td>@r.Actor</td><td>@r.Record</td><td>@r.Action</td><td>@r.Field</td></tr>}</tbody></table>@if(Model.Audits.Count == 0){<p class="empty">No audit events available.</p>}</div></div>
  }
  <p class="muted mt-3 small">All counts are derived from authorized live records. CSV opens in Excel. Print / Save as PDF is available from the Management Summary; native XLSX and automated PDF generation are not implemented. Historical baseline tracking and structured risk integration require additional data.</p>
</div>
